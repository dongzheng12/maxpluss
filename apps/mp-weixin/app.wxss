page {
  background: #f4f7fa;
  color: #223247;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  min-height: 100%;
}

.page-shell {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.topbar-back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #d8e0e8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #223247;
  font-size: 34rpx;
}

.topbar-title {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-card {
  background: #ffffff;
  border: 1rpx solid rgba(215, 224, 233, 0.96);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(29, 48, 74, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.search-shell {
  background: #f1f5f8;
  border: 1rpx solid #d5e0ea;
  border-radius: 24rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-icon {
  color: #9cabbb;
  font-size: 34rpx;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  width: 100%;
  min-height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.primary-btn {
  background: #3b6288;
  color: #ffffff;
}

.primary-btn.disabled {
  background: #d6dbe4;
  color: #ffffff;
}

.secondary-btn {
  background: #edf3f8;
  color: #3b6288;
  border: 1rpx solid #ced9e4;
}

.ghost-btn {
  background: #ffffff;
  color: #3b6288;
  border: 1rpx solid #d0d9e2;
}

.meta-text {
  color: #7d8a9a;
  font-size: 26rpx;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.tag-blue {
  color: #3b6288;
  background: #edf3f8;
}

.tag-green {
  color: #17a34a;
  background: #ebf9ef;
}

.tag-orange {
  color: #f06a00;
  background: #fff2e7;
}

.tag-purple {
  color: #8f38ff;
  background: #f4ecff;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-arrow {
  color: #a2acb8;
  font-size: 40rpx;
  line-height: 1;
}

.empty-card {
  padding: 56rpx 24rpx;
  text-align: center;
  color: #8d95a3;
  font-size: 28rpx;
}

/* ══════════════════════════════════════════════════════════
   全局布局规范（2026-04-12 统一治理）
   ══════════════════════════════════════════════════════════
   规则：
   - 禁止 calc(Nvh - Mrpx)，用 flex: 1 + min-height 替代
   - 禁止 calc((100% - Nrpx) / M)，用百分比 width 替代
   - 所有 position: fixed 元素必须带 box-sizing: border-box
   - 宫格统一用 .grid-3col / .grid-4col，不在页面里自己算
   - 行截断统一用 .text-ellipsis / .text-clamp-2 / .text-clamp-3
   ══════════════════════════════════════════════════════════ */

/* ── 宫格布局（真机安全：不用 gap，用 margin/padding 控制间距） ── */
.grid-3col { display: flex; flex-wrap: wrap; margin: -8rpx; }
.grid-3col > view { width: 33.33%; padding: 8rpx; box-sizing: border-box; }
.grid-4col { display: flex; flex-wrap: wrap; justify-content: space-between; }
.grid-4col > view { width: 23%; margin-bottom: 12rpx; box-sizing: border-box; }

/* ── 底部操作栏（统一 fixed 安全区） ── */
.bottom-action-bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
  z-index: 100;
}

/* ── 全屏遮罩 ── */
.full-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(0,0,0,0.35);
  z-index: 100;
}

/* ── 文本截断 ── */
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.text-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6; }
.text-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6; }

/* ── 弹性填充容器（替代 calc(100vh - Nrpx)）── */
.flex-fill { flex: 1; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; }

/* ── AI 生成内容声明（深度合成合规标注）── */
.ai-disclaimer {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 24rpx 0 16rpx;
  letter-spacing: 1rpx;
}
.ai-disclaimer-inline {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 0 4rpx;
  letter-spacing: 1rpx;
}
