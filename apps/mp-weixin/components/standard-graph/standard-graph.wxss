.graph-container {
  width: 100%;
  min-height: 620rpx;
  background-color: #f8fafc;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  border-radius: 28rpx;
  overflow: hidden;
}

/* 统计卡片 */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}

.metric-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  background: #f1f5f9;
  border-radius: 12rpx;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.metric-label {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

/* 图谱画布 */
.canvas-area {
  position: relative;
  height: 620rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中心节点 */
.node-center {
  width: 208rpx;
  height: 208rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  text-align: center;
  padding: 18rpx;
  z-index: 10;
  border: 8rpx solid rgba(255, 255, 255, 0.2);
}

.center-code {
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.center-name {
  font-size: 18rpx;
  line-height: 1.4;
  opacity: 0.9;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.center-badge {
  background: rgba(0, 0, 0, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 16rpx;
  margin-top: 10rpx;
}

/* 关系节点 */
.node-relation {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.relation-line {
  position: absolute;
  height: 2rpx;
  background: #e2e8f0;
  left: 50%;
  top: 50%;
  transform-origin: left center;
  z-index: -1;
}

.node-relation:active .relation-circle {
  transform: scale(1.1);
  background: #f8fafc;
}

.relation-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #e2e8f0;
  transition: all 0.3s ease;
}

.node-relation.versions .relation-circle { border-color: #f59e0b; color: #f59e0b; }
.node-relation.series .relation-circle { border-color: #3b82f6; color: #3b82f6; }
.node-relation.similar .relation-circle { border-color: #10b981; color: #10b981; }
.node-relation.total .relation-circle { border-color: #8b5cf6; color: #8b5cf6; }

.relation-text {
  font-size: 20rpx;
  font-weight: 500;
}

.relation-count {
  font-size: 24rpx;
  font-weight: 700;
}

/* 详情面板 */
.detail-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60vh;
  background: #fff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  transform: translateY(0);
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.panel-header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f1f5f9;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.close-btn {
  font-size: 48rpx;
  color: #94a3b8;
  padding: 0 10rpx;
}

.panel-content {
  flex: 1;
  padding: 24rpx;
  max-height: 60vh; min-height: 300rpx;
}

/* 列表样式 */
.summary-panel {
  padding: 0;
}

.summary-intro {
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  background: #f7f8fb;
  border-radius: 16rpx;
}

.summary-intro-text {
  font-size: 26rpx;
  color: #647085;
  line-height: 1.7;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.summary-card {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.summary-card-total {
  background: #f4efff;
}

.summary-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
}

.summary-label {
  font-size: 24rpx;
  color: #64748b;
}

.list-container {
  padding: 0;
}

.series-summary {
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  background: #f7f8fb;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #647085;
  line-height: 1.6;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 20rpx;
}

.item-code {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.item-name {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.status-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.status-tag.green { background: #dcfce7; color: #166534; }
.status-tag.gray { background: #f1f5f9; color: #64748b; }

.type-tag {
  font-size: 20rpx;
  background: #e0f2fe;
  color: #0369a1;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 时间线样式 */
.timeline {
  padding: 20rpx 40rpx;
}

.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 40rpx;
  border-left: 2rpx solid #e2e8f0;
}

.timeline-item:last-child {
  border-left: 2rpx solid transparent;
  padding-bottom: 0;
}

.timeline-item.active .time-node {
  background: #3b82f6;
  border-color: #dbeafe;
  box-shadow: 0 0 0 8rpx rgba(59, 130, 246, 0.1);
}

.time-node {
  position: absolute;
  left: -11rpx;
  top: 0;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #cbd5e1;
  border: 4rpx solid #fff;
}

.time-content {
  background: #fff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #f1f5f9;
}

.active .time-content {
  background: #eff6ff;
  border-color: #3b82f6;
}

.time-code {
  font-size: 24rpx;
  font-weight: 700;
}

.time-name {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

.animate-fade-in {
  animation: fadeIn 0.5s ease-out forwards;
}

.shadow-sm { box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); }
.shadow-lg { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
.shadow-up { box-shadow: 0 -4px 6px -1px rgba(0, 0, 0, 0.05); }
