.booking-hero {
  margin: 0 -24rpx 18rpx;
  padding: 28rpx 32rpx;
  background: #dfeafb;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.booking-hero-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #2b63f6;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex: none;
}

.booking-hero-copy {
  flex: 1;
}

.booking-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  color: #1f2a44;
}

.booking-desc {
  color: #5e697e;
  font-size: 30rpx;
  line-height: 1.75;
}

.booking-form {
  padding: 28rpx 24rpx;
  margin-bottom: 18rpx;
}

.booking-service-card,
.booking-process-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
}

.booking-service-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.booking-service-item {
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f7f8fb;
}

.booking-service-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2a44;
}

.booking-service-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #667389;
}

.booking-field + .booking-field {
  margin-top: 26rpx;
}

.booking-label {
  margin-bottom: 14rpx;
  color: #344056;
  font-size: 32rpx;
  font-weight: 700;
}

.booking-input,
.booking-picker,
.booking-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d6dce6;
  border-radius: 22rpx;
  background: #fff;
  color: #1f2a44;
  font-size: 30rpx;
}

.booking-input,
.booking-picker {
  min-height: 88rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
}

.booking-picker {
  justify-content: space-between;
  color: #1f2a44;
}

.booking-picker-arrow {
  color: #7f8898;
  font-size: 28rpx;
}

.booking-textarea {
  min-height: 220rpx;
  padding: 20rpx 22rpx;
  line-height: 1.7;
}

.booking-process-item + .booking-process-item {
  margin-top: 16rpx;
}

.booking-process-item {
  font-size: 27rpx;
  color: #667389;
  line-height: 1.65;
}

