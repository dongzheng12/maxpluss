.home-hero {
  padding: 32rpx 28rpx 28rpx;
  background: linear-gradient(160deg, #1a3f6b 0%, #2d67cc 60%, #5eabff 100%);
  color: #fff;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  line-height: 1.5;
  margin-bottom: 26rpx;
}
.hero-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(255,255,255,0.98);
  border-radius: 20rpx;
  padding: 10rpx 14rpx 10rpx 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(15,23,42,0.12);
}
.hero-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #223247;
  background: transparent;
  padding: 0;
}
.hero-input-placeholder { color: #8091a5; font-size: 28rpx; }
.hero-send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #2d67cc, #1a3f6b);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.hero-send-arrow {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
  margin-top: -6rpx;
}
.quick-entry-card, .home-notice-card, .stats-card { padding: 28rpx; margin-top: 20rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; grid-gap: 16rpx; }
.quick-item { }
.quick-item-inner { min-height: 152rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid #e8edf2; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16rpx 8rpx; font-size: 26rpx; font-weight: 600; color: #304255; box-sizing: border-box; box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04); }
.quick-item-inner > .quick-icon-shell { margin-bottom: 14rpx; }
.quick-icon-shell { width: 92rpx; height: 92rpx; border-radius: 28rpx; background: #eef4f8; border: 1rpx solid #d3dde7; display: flex; align-items: center; justify-content: center; }
.quick-icon-img { width: 46rpx; height: 46rpx; }
.home-service-card { margin-top: 20rpx; padding: 24rpx 28rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.home-service-copy { flex: 1; }
.home-service-title { font-size: 34rpx; font-weight: 700; margin-bottom: 8rpx; }
.home-service-desc { font-size: 26rpx; line-height: 1.6; color: #677586; }
.home-service-action { min-width: 164rpx; height: 72rpx; border-radius: 999rpx; background: #edf3f8; color: #365b81; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 700; }
.notice-item { padding: 18rpx 0; border-top: 1rpx solid #edf2f6; }
.notice-item:first-of-type { border-top: 0; padding-top: 8rpx; }
.notice-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.notice-date { color: #8995a4; font-size: 26rpx; }
.member-banner { margin-top: 20rpx; padding: 22rpx 26rpx; border-radius: 28rpx; background: linear-gradient(135deg, #fff8e1 0%, #ffe082 100%); display: flex; align-items: center; justify-content: space-between; gap: 18rpx; box-shadow: 0 4rpx 16rpx rgba(255, 193, 7, 0.15); }
.member-title { font-size: 36rpx; font-weight: 700; margin-bottom: 6rpx; color: #5f4923; }
.member-desc { color: #75684c; font-size: 26rpx; }
.member-action { min-width: 180rpx; height: 72rpx; border-radius: 999rpx; background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 28rpx; box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3); }
.stats-card { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; }
.stat-item { text-align: center; }
.stat-value { font-size: 36rpx; font-weight: 700; color: #294766; }
.stat-label { font-size: 22rpx; color: #7f8898; margin-top: 6rpx; }
.home-fail-tip {
  margin: 18rpx 0 0;
  padding: 24rpx;
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  color: #874d00;
  font-size: 28rpx;
  text-align: center;
  border-radius: 16rpx;
}
