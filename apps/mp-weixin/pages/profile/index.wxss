.profile-hero { margin: -24rpx -24rpx 0; padding: 40rpx 32rpx 110rpx; background: linear-gradient(135deg, #294766 0%, #567594 100%); color: #fff; display: flex; align-items: center; gap: 20rpx; }
.profile-avatar { width: 108rpx; height: 108rpx; border-radius: 999rpx; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.profile-avatar-image { width: 108rpx; height: 108rpx; border-radius: 999rpx; background: rgba(255,255,255,0.2); }
.profile-title { font-size: 42rpx; font-weight: 700; margin-bottom: 8rpx; }
.profile-subtitle { font-size: 28rpx; opacity: 0.92; }
.profile-member-banner { margin-top: -72rpx; margin-bottom: 22rpx; border-radius: 28rpx; background: linear-gradient(135deg, #ede2c8 0%, #dcc29c 100%); padding: 26rpx 28rpx; color: #5f4923; display: flex; align-items: center; justify-content: space-between; }
.profile-member-banner.paid { background: linear-gradient(135deg, #627992 0%, #495e76 100%); color: #fff; }
.profile-member-title { font-size: 40rpx; font-weight: 700; margin-bottom: 8rpx; }
.profile-member-desc { font-size: 28rpx; color: #75684c; }
.profile-member-banner.paid .profile-member-desc { color: rgba(255,255,255,0.88); }
.profile-menu { padding: 0 24rpx; }
.profile-menu-item { min-height: 108rpx; border-top: 1rpx solid #edf2f6; display: flex; align-items: center; justify-content: space-between; font-size: 34rpx; font-weight: 600; }
.profile-menu-item:first-child { border-top: 0; }
.profile-menu-main { display: flex; align-items: center; gap: 20rpx; }
.profile-menu-icon-shell { width: 72rpx; height: 72rpx; border-radius: 22rpx; background: #eef4f8; border: 1rpx solid #d3dde7; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.profile-menu-icon { width: 34rpx; height: 34rpx; display: block; }
.profile-menu-label { color: #2b3950; }
.bind-phone-tip { margin-bottom: 20rpx; padding: 20rpx 28rpx; border-radius: 20rpx; background: #eef4ff; border: 2rpx solid #c6daff; display: flex; align-items: center; justify-content: space-between; font-size: 28rpx; color: #1a3f6b; }
.bind-phone-text { display: flex; align-items: center; gap: 12rpx; }
.bind-phone-icon { font-size: 36rpx; }
