<view class="page-shell">
  <view class="profile-hero" bindtap="onHeroTap">
    <image wx:if="{{hasAvatar}}" class="profile-avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
    <view wx:else class="profile-avatar">◯</view>
    <view>
      <view class="profile-title">{{displayName}}</view>
      <view class="profile-subtitle">{{displaySubtitle}}</view>
    </view>
  </view>

  <!-- 未付费：开通会员横幅 -->
  <view wx:if="{{!isPaid}}" class="profile-member-banner" bindtap="goMembership">
    <view>
      <view class="profile-member-title">开通会员</view>
      <view class="profile-member-desc">{{profileMembershipHint}}</view>
    </view>
    <view class="list-arrow" style="color:#7d6137;">›</view>
  </view>

  <!-- 已付费：显示当前等级横幅 -->
  <view wx:else class="profile-member-banner paid" bindtap="goMyMember">
    <view>
      <view class="profile-member-title">{{tierLabel}}</view>
      <view class="profile-member-desc">有效期至 {{expireDate}}</view>
    </view>
    <view class="list-arrow" style="color:#fff;">›</view>
  </view>

  <!-- 绑定手机提示 -->
  <view wx:if="{{needBindPhone}}" class="bind-phone-tip" bindtap="goBindPhone">
    <view class="bind-phone-text">
      <text class="bind-phone-icon">📱</text>
      <text>绑定手机号，电脑端也能登录</text>
    </view>
    <text class="list-arrow" style="color:#1677ff;">去绑定 ›</text>
  </view>

  <view class="section-card profile-menu">
    <view class="profile-menu-item" bindtap="goOrders">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><image class="profile-menu-icon" src="/assets/profile/orders.png" mode="aspectFit" /></view>
        <text class="profile-menu-label">我的订单</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goMyMember">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><image class="profile-menu-icon" src="/assets/profile/member.png" mode="aspectFit" /></view>
        <text class="profile-menu-label">我的会员</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goMyCoupons">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><text style="font-size:36rpx;">◇</text></view>
        <text class="profile-menu-label">我的优惠券</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goFavorites">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><text style="font-size:36rpx;">☆</text></view>
        <text class="profile-menu-label">我的收藏</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goCompare">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><text style="font-size:36rpx;">⇄</text></view>
        <text class="profile-menu-label">比对任务</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goBookings">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><image class="profile-menu-icon" src="/assets/profile/bookings.png" mode="aspectFit" /></view>
        <text class="profile-menu-label">预约记录</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goReferral">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><text style="font-size:36rpx;">♡</text></view>
        <text class="profile-menu-label">邀请好友</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goService">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><image class="profile-menu-icon" src="/assets/profile/service.png" mode="aspectFit" /></view>
        <text class="profile-menu-label">联系客服</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goAbout">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><image class="profile-menu-icon" src="/assets/profile/about.png" mode="aspectFit" /></view>
        <text class="profile-menu-label">关于我们</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="profile-menu-item" bindtap="goSettings">
      <view class="profile-menu-main">
        <view class="profile-menu-icon-shell"><image class="profile-menu-icon" src="/assets/profile/settings.png" mode="aspectFit" /></view>
        <text class="profile-menu-label">设置</text>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>
</view>
