/* 页面级 flex 纵向布局（覆盖全局 .page-shell） */
.page-shell { display: flex; flex-direction: column; min-height: 100vh; }

/* ── 搜索栏（复用全局样式）── */
.filter-link { color: #2b63f6; font-size: 28rpx; font-weight: 600; }

/* ── 空状态 ── */
.empty-state { padding: 120rpx 40rpx; text-align: center; }
.empty-illustration { margin-bottom: 32rpx; }
.empty-circle { width: 120rpx; height: 120rpx; margin: 0 auto; border-radius: 50%; background: #edf3ff; display: flex; align-items: center; justify-content: center; }
.empty-glyph { font-size: 56rpx; color: #2b63f6; }
.empty-text-main { font-size: 30rpx; color: #40506b; font-weight: 600; margin-bottom: 12rpx; }
.empty-text-sub { font-size: 26rpx; color: #99a3b4; }

/* ── 内容布局：左侧分类 + 右侧列表 ── */
.content-layout { display: flex; flex: 1; min-height: 0; }

/* 左侧分类栏 */
.cat-sidebar { width: 160rpx; flex-shrink: 0; background: #f6f8fc; border-right: 1rpx solid #edf0f5; }
.cat-item { padding: 28rpx 16rpx; text-align: center; border-bottom: 1rpx solid #edf0f5; position: relative; }
.cat-item.active { background: #fff; }
.cat-item.active::before { content: ''; position: absolute; left: 0; top: 20%; height: 60%; width: 6rpx; background: #2b63f6; border-radius: 0 6rpx 6rpx 0; }
.cat-label { display: block; font-size: 28rpx; color: #5f6b81; font-weight: 600; }
.cat-item.active .cat-label { color: #2b63f6; }
.cat-count { display: block; margin-top: 6rpx; font-size: 22rpx; color: #99a3b4; }
.cat-item.active .cat-count { color: #2b63f6; }

/* 右侧主内容 */
.result-main { flex: 1; padding: 0 20rpx; }

/* 顶部状态筛选栏 */
.status-bar { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 18rpx 0 8rpx; }
.status-chip { padding: 10rpx 20rpx; border-radius: 999rpx; background: #f0f2f5; color: #5f6b81; font-size: 24rpx; font-weight: 600; }
.status-chip.active { background: #edf3ff; color: #2b63f6; border: 1rpx solid #c9d9ff; }
.status-count { margin-left: 4rpx; }

/* 结果计数 + 排序工具栏 */
.result-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0 10rpx; }
.result-count { font-size: 24rpx; color: #99a3b4; }
.sort-trigger { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 16rpx; background: #f0f4ff; border-radius: 24rpx; }
.sort-trigger:active { background: #dce8ff; }
.sort-trigger-text { font-size: 24rpx; color: #2b63f6; font-weight: 600; }
.sort-trigger-icon { font-size: 22rpx; color: #2b63f6; }

/* ── 标准卡片（保留原有样式）── */
.standard-card { margin-bottom: 18rpx; padding: 24rpx; }
.standard-tags { display: flex; gap: 12rpx; margin-bottom: 18rpx; flex-wrap: wrap; }
.standard-code { color: #2b63f6; font-size: 36rpx; font-weight: 700; margin-bottom: 10rpx; }
.standard-title { font-size: 30rpx; font-weight: 700; line-height: 1.45; margin-bottom: 10rpx; }
.standard-meta { display: flex; justify-content: space-between; gap: 16rpx; color: #7f8898; font-size: 24rpx; }
.standard-link-row { margin-top: 14rpx; display: flex; justify-content: flex-end; gap: 12rpx; flex-wrap: wrap; }
.standard-link-pill { padding: 10rpx 18rpx; border-radius: 999rpx; background: #edf3ff; color: #2b63f6; font-size: 22rpx; font-weight: 700; }

/* tag colors */
.tag { padding: 6rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 600; }
.tag-green { background: #e8f8ef; color: #1a9a5a; }
.tag-orange { background: #fff4e6; color: #d97706; }
.tag-gray { background: #f0f2f5; color: #7f8898; }
.tag-blue { background: #edf3ff; color: #2b63f6; }

/* loading & end */
.loading-tip { text-align: center; padding: 32rpx 0; font-size: 26rpx; color: #99a3b4; }
.end-tip { color: #c5cdd8; }

/* ════════════════════════════════════════════════════════════ */
/* ═══ 双 Tab 切换条(2026-04-30 行业推荐合并)═══ */
/* ════════════════════════════════════════════════════════════ */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #edf0f5;
  position: sticky; top: 0; z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #5f6b81;
  font-weight: 600;
  position: relative;
}
.tab-item.active {
  color: #2b63f6;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%; bottom: 0;
  transform: translateX(-50%);
  width: 60rpx; height: 6rpx;
  background: #2b63f6;
  border-radius: 6rpx 6rpx 0 0;
}

/* ════════════════════════════════════════════════════════════ */
/* ═══ industry Tab 样式(port 自 /pages/industry/index.wxss,加 .ind-pane 前缀防冲突)═══ */
/* ════════════════════════════════════════════════════════════ */

/* 搜索卡片 */
.ind-pane .search-card { padding: 32rpx; margin-bottom: 24rpx; }

.ind-pane .search-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; align-items: center; }
.ind-pane .search-input-wrap {
  flex: 1; display: flex; align-items: center; gap: 14rpx;
  padding: 0 24rpx; height: 80rpx; border-radius: 16rpx;
  background: #f5f7fa; border: 2rpx solid #e8ecf2;
}
.ind-pane .search-input-wrap:active { border-color: #2b63f6; }
.ind-pane .search-icon-glyph { font-size: 32rpx; color: #bfc8d6; flex-shrink: 0; }
.ind-pane .search-input { flex: 1; font-size: 28rpx; color: #1a2236; }

/* 右侧行业下拉入口 */
.ind-pane .search-ind-trigger {
  height: 80rpx; padding: 0 20rpx; border-radius: 16rpx;
  background: #edf3ff; border: 2rpx solid #d4dffa;
  display: flex; align-items: center; gap: 8rpx;
  flex-shrink: 0;
}
.ind-pane .search-ind-trigger:active { background: #dce8ff; }
.ind-pane .ind-trigger-text { font-size: 26rpx; color: #2b63f6; font-weight: 600; white-space: nowrap; }
.ind-pane .ind-trigger-icon { font-size: 24rpx; color: #2b63f6; }

/* 热门标签 */
.ind-pane .hot-section { }
.ind-pane .hot-label { font-size: 22rpx; color: #b0b8c8; margin-bottom: 12rpx; }
.ind-pane .hot-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.ind-pane .hot-tag {
  padding: 12rpx 26rpx; border-radius: 999rpx;
  background: #f5f7fa; border: 1rpx solid #e8ecf2;
  font-size: 24rpx; color: #5c6b82;
}
.ind-pane .hot-tag:active { background: #edf3ff; color: #2b63f6; border-color: #c5d5ff; }

/* 统计卡片 */
.ind-pane .stats-row {
  display: flex; gap: 16rpx; padding: 0 0; margin-bottom: 24rpx;
}
.ind-pane .stat-box {
  flex: 1; background: #fff; border-radius: 20rpx;
  padding: 28rpx 16rpx; text-align: center;
  border: 1rpx solid rgba(209,214,222,0.6);
  box-shadow: 0 4rpx 16rpx rgba(28,44,73,0.04);
}
.ind-pane .stat-num {
  font-size: 44rpx; font-weight: 800; margin-bottom: 4rpx;
  font-variant-numeric: tabular-nums;
}
.ind-pane .stat-num.total { color: #1a2236; }
.ind-pane .stat-num.mandatory { color: #2b63f6; }
.ind-pane .stat-num.recommended { color: #0aa649; }
.ind-pane .stat-desc { font-size: 22rpx; color: #99a3b4; }

/* 类型筛选 */
.ind-pane .filter-card { padding: 20rpx 0 20rpx 24rpx; margin-bottom: 24rpx; }
.ind-pane .filter-scroll { white-space: nowrap; }
.ind-pane .filter-row { display: inline-flex; gap: 14rpx; padding-right: 24rpx; }
.ind-pane .filter-chip {
  padding: 14rpx 28rpx; border-radius: 999rpx;
  background: #f5f7fa; border: 1rpx solid #e8ecf2;
  font-size: 24rpx; color: #5c6b82; white-space: nowrap;
  display: inline-flex; align-items: center;
}
.ind-pane .filter-chip.active {
  background: linear-gradient(135deg, #2b63f6, #4f8cff);
  color: #fff; border-color: transparent; font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(43,99,246,0.2);
}
.ind-pane .filter-count { margin-left: 4rpx; }

/* 标准列表 */
.ind-pane .list-card { padding: 28rpx 24rpx; margin-bottom: 24rpx; }
.ind-pane .list-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20rpx;
}
.ind-pane .list-title { font-size: 30rpx; font-weight: 700; color: #1a2236; }
.ind-pane .list-badge {
  padding: 6rpx 18rpx; border-radius: 999rpx;
  background: #edf3ff; color: #2b63f6;
  font-size: 22rpx; font-weight: 600;
}

.ind-pane .std-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid #f0f2f6;
}
.ind-pane .std-item:last-child { border-bottom: none; }
.ind-pane .std-item:active { background: #fafbfe; margin: 0 -24rpx; padding: 24rpx; border-radius: 12rpx; }

.ind-pane .std-left { flex: 1; min-width: 0; }
.ind-pane .std-code {
  font-size: 26rpx; font-weight: 700; color: #2b63f6;
  margin-bottom: 6rpx; font-variant-numeric: tabular-nums;
}
.ind-pane .std-name {
  font-size: 26rpx; color: #1a2236; line-height: 1.6;
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}

.ind-pane .std-right { flex-shrink: 0; text-align: right; }
.ind-pane .std-status {
  display: inline-block;
  padding: 6rpx 18rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 500; white-space: nowrap;
  background: #f5f5f5; color: #757575;
}
.ind-pane .status-active { background: #e6f8ee; color: #0aa649; }
.ind-pane .status-upcoming { background: #e3f2fd; color: #1565c0; }
.ind-pane .std-dates { margin-top: 8rpx; }
.ind-pane .std-date { display: block; font-size: 20rpx; color: #99a3b4; line-height: 1.6; }

.ind-pane .empty-inline {
  padding: 60rpx 20rpx; text-align: center;
  color: #99a3b4; font-size: 26rpx;
}

/* 分页 */
.ind-pane .pagination {
  display: flex; justify-content: center; align-items: center;
  gap: 32rpx; padding: 16rpx 0 24rpx;
}
.ind-pane .page-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #fff; border: 1rpx solid #e0e5ec;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.ind-pane .page-btn:active { background: #f5f7fa; }
.ind-pane .page-btn.disabled { opacity: 0.25; }
.ind-pane .page-arrow { font-size: 28rpx; color: #3d4d66; }
.ind-pane .page-info { font-size: 26rpx; color: #99a3b4; font-variant-numeric: tabular-nums; }

/* 空状态(industry 专用,wxml 用 .ind-empty-state 命名避免与 keyword Tab 冲突) */
.ind-pane .ind-empty-state { padding: 100rpx 40rpx 60rpx; text-align: center; }
.ind-pane .ind-empty-state .empty-illustration { margin-bottom: 32rpx; }
.ind-pane .ind-empty-state .empty-circle {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(135deg, #edf3ff, #f5f0ff);
  display: inline-flex; align-items: center; justify-content: center;
}
.ind-pane .ind-empty-state .empty-glyph { font-size: 52rpx; color: #2b63f6; opacity: 0.6; }
.ind-pane .ind-empty-state .empty-text-main { font-size: 30rpx; color: #3d4d66; font-weight: 600; margin-bottom: 8rpx; }
.ind-pane .ind-empty-state .empty-text-sub { font-size: 24rpx; color: #99a3b4; }

/* 错误 */
.ind-pane .error-toast {
  display: flex; align-items: center; gap: 12rpx;
  margin: 24rpx 0; padding: 24rpx 28rpx;
  background: #fef0f0; border: 1rpx solid #fdd; color: #e54545;
  border-radius: 18rpx; font-size: 26rpx;
}
.ind-pane .error-icon {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #e54545; color: #fff; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

/* Loading 蒙层 */
.ind-pane .loading-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(8rpx);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.ind-pane .loading-spinner-wrap {
  display: flex; flex-direction: column; align-items: center; gap: 24rpx;
}
.ind-pane .loading-spinner {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  border: 6rpx solid #e8ecf2;
  border-top-color: #2b63f6;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.ind-pane .loading-text {
  font-size: 28rpx; color: #5c6b82; font-weight: 500;
}
