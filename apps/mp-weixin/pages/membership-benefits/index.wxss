.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a2b42;
  text-align: center;
  padding-top: 32rpx;
}
.page-desc {
  font-size: 26rpx;
  color: #8c8c8c;
  text-align: center;
  margin-bottom: 24rpx;
}
.benefit-section { padding: 24rpx 16rpx; margin-bottom: 16rpx; }

.benefit-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.benefit-row:last-child { border-bottom: none; }
.benefit-header {
  font-weight: 600;
  color: #595959;
  font-size: 24rpx;
  border-bottom: 2rpx solid #e8e8e8;
}

.benefit-cell { text-align: center; font-size: 24rpx; color: #595959; }
.cell-name { flex: 2.5; text-align: left; font-size: 24rpx; color: #262626; }
.cell-val { flex: 1; font-size: 22rpx; }
.cell-visitor { color: #8c8c8c; }
.cell-personal { color: #1677ff; }
.cell-pro { color: #fa8c16; }

.val-yes { color: #52c41a; font-weight: 600; }
.val-no { color: #d9d9d9; }
.val-limit { color: #1677ff; font-size: 22rpx; }

/* 价格对照 */
.price-compare { padding: 24rpx; }
.price-row { display: flex; gap: 12rpx; }
.price-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: #f9f9f9;
  border-radius: 12rpx;
}
.price-personal { background: #e6f4ff; }
.price-pro { background: #fff7e6; }
.price-label { font-size: 24rpx; color: #8c8c8c; margin-bottom: 8rpx; }
.price-val { font-size: 30rpx; font-weight: 700; color: #262626; }
.price-personal .price-val { color: #1677ff; }
.price-pro .price-val { color: #fa8c16; }

/* 说明 */
.notes-card { padding: 24rpx; }
.note-item {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 2;
}
