.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f6f8;
}

/* ── 顶部栏 ── */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #ecf0f4;
  gap: 16rpx;
}
.top-bar-brand {
  flex: 1;
  min-width: 0;
}
.top-bar-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #223247;
  line-height: 1;
}
.top-bar-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.top-bar-action {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f2f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
}
.top-bar-action-primary {
  background: #eaf3ff;
}
.top-bar-action-text {
  font-size: 24rpx;
  color: #2c6eb8;
  font-weight: 600;
  line-height: 1;
}
.top-bar-action:not(.top-bar-action-primary) .top-bar-action-text {
  color: #516174;
}

/* ── 历史会话面板（紧凑侧边栏） ── */
.history-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 100;
}
.history-panel {
  position: absolute;
  top: 0; left: 0; bottom: 0;
  width: 460rpx;
  background: #fff;
  border-radius: 0 20rpx 20rpx 0;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
}
.history-header {
  margin-bottom: 18rpx;
}
.history-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #223247;
}
.history-list {
  flex: 1;
}
.history-empty {
  text-align: center;
  color: #8ea0b2;
  margin-top: 60rpx;
  font-size: 26rpx;
}
.history-item {
  padding: 14rpx 14rpx;
  border-radius: 10rpx;
  margin-bottom: 4rpx;
}
.history-item.active {
  background: #eaf3ff;
}
.history-item-title {
  font-size: 26rpx;
  color: #304255;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.history-item-time {
  font-size: 20rpx;
  color: #8ea0b2;
  margin-top: 4rpx;
  display: block;
}

/* ── 消息列表 ── */
.message-list {
  flex: 1;
}
.message-list-inner {
  padding: 16rpx 20rpx;
}

/* ── 欢迎界面（精简） ── */
.welcome {
  padding: 48rpx 24rpx 24rpx;
}
.welcome-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #223247;
  margin-bottom: 28rpx;
  line-height: 1.3;
}
.welcome-chips-label {
  font-size: 22rpx;
  color: #8ea0b2;
  margin-bottom: 14rpx;
}
.welcome-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.welcome-chip {
  flex: 1 1 calc(50% - 7rpx);
  min-width: 0;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 24rpx;
  color: #3b4a5c;
  line-height: 1.45;
  box-sizing: border-box;
}

/* ── 消息行布局（硬约束） ──
 *
 * 屏幕 750rpx - message-list padding 2×20rpx = 可用 710rpx
 * 头像 52rpx + 间距 12rpx = 64rpx
 * 内容列 max 600rpx（710 - 64 = 646，取 600 留安全边距）
 * 用户消息：justify-content: flex-end → 右对齐
 * 助手消息：默认 flex-start → 左对齐
 */
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 22rpx;
  padding: 0;
}
.msg-user {
  justify-content: flex-end;
}
.msg-avatar {
  width: 52rpx;
  height: 52rpx;
  min-width: 52rpx;
  min-height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
  flex-grow: 0;
  color: #fff;
  margin-top: 2rpx;
}
.avatar-assistant { background: #3b6288; }
.avatar-user { background: #516174; }
.msg-content {
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.msg-user .msg-content {
  align-items: flex-end;
}
.msg-bubble {
  max-width: 100%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  word-break: break-word;
  line-height: 1.6;
  box-sizing: border-box;
}
.bubble-user {
  background: #2c6eb8;
  color: #fff;
  border-top-right-radius: 6rpx;
}
.bubble-assistant {
  background: #fff;
  color: #333;
  border-top-left-radius: 6rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}
.bubble-blocked {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
}

/* ── 搜索结果卡片 ── */
.search-cards {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.std-card {
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.std-card-code {
  font-size: 26rpx;
  font-weight: 600;
  color: #1677ff;
  margin-bottom: 4rpx;
}
.std-card-title {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.std-card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
}
.std-card-status {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}
.std-status-active {
  background: #f6ffed;
  color: #52c41a;
  border: 1rpx solid #b7eb8f;
}
.std-status-other {
  background: #f5f5f5;
  color: #999;
}
.std-card-date {
  color: #999;
}

/* ── 任务列表卡片 ── */
.task-cards {
  margin-top: 12rpx;
  max-width: 75%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.task-card {
  background: #fff;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.task-card-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.task-card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
}
.task-card-no {
  color: #999;
}
.task-card-status {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.task-status-PENDING {
  background: #fff7e6;
  color: #fa8c16;
}
.task-status-PROCESSING {
  background: #e6f4ff;
  color: #1677ff;
}
.task-status-COMPLETED {
  background: #f6ffed;
  color: #52c41a;
}
.task-status-FAILED {
  background: #fff1f0;
  color: #ff4d4f;
}

/* ── 大纲操作按钮 ── */
.outline-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  max-width: 75%;
}
.outline-btn {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}
.outline-btn-primary {
  background: #1677ff;
  color: #fff;
}
.outline-btn-default {
  background: #f5f6f8;
  color: #333;
  border: 1rpx solid #d9d9d9;
}

/* ── 框架完成提示 ── */
.framework-done-hint {
  margin-top: 12rpx;
  max-width: 75%;
  padding: 12rpx 20rpx;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #52c41a;
}
.msg-text {
  font-size: 28rpx;
}
.suggestion-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.suggestion-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f0f5ff;
  color: #2c6eb8;
  font-size: 24rpx;
  line-height: 1.2;
}

/* ── 闪烁光标 ── */
@keyframes blink {
  50% { opacity: 0; }
}
.streaming-cursor {
  animation: blink 0.8s step-end infinite;
  color: #722ed1;
  font-weight: 700;
}

/* ── 底部输入区 ── */
.input-area {
  background: #fff;
  border-top: 1rpx solid #ecf0f4;
  padding: 12rpx 20rpx;
  padding-bottom: calc(4rpx + env(safe-area-inset-bottom));
}
.quota-hint {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.upgrade-link {
  color: #1677ff;
}
.input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.ai-disclaimer {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 0 4rpx;
  letter-spacing: 1rpx;
}
.input-box {
  flex: 1;
  background: #f2f5f9;
  border-radius: 22rpx;
  padding: 22rpx 26rpx;
  font-size: 30rpx;
  max-height: 260rpx;
  min-height: 88rpx;
  line-height: 1.5;
}
.send-btn {
  background: #2c6eb8;
  color: #fff;
  border-radius: 22rpx;
  padding: 0 36rpx;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
}
.send-btn-disabled {
  background: #b4bdc8;
}

/* ─── 置信度标签 🟢🟡🔴（方案 §3.5） ─── */
.confidence-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  margin-bottom: 10rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.confidence-emoji { font-size: 24rpx; }
.confidence-label { font-weight: 600; }
.confidence-high {
  background: rgba(82, 196, 26, 0.10);
  color: #389e0d;
  border: 1rpx solid rgba(82, 196, 26, 0.32);
}
.confidence-medium {
  background: rgba(250, 173, 20, 0.12);
  color: #d48806;
  border: 1rpx solid rgba(250, 173, 20, 0.34);
}
.confidence-low {
  background: rgba(245, 34, 45, 0.10);
  color: #cf1322;
  border: 1rpx solid rgba(245, 34, 45, 0.32);
}

/* ─── 联网搜索来源列表（🟡）─── */
.web-search-list {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(250, 173, 20, 0.06);
  border: 1rpx dashed rgba(250, 173, 20, 0.34);
}
.web-search-header {
  font-size: 24rpx;
  color: #8c6310;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.web-search-item {
  display: flex;
  flex-direction: column;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #1f2d3d;
}
.web-search-title {
  line-height: 1.5;
}
.web-search-site {
  font-size: 22rpx;
  color: #8a98ac;
  margin-top: 2rpx;
}
