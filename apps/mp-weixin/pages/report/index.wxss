/* 报告页样式 */
.report-loading { text-align: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }
.report-head-card { padding: 24rpx; margin-bottom: 18rpx; }
.report-head-title { font-size: 38rpx; font-weight: 700; margin-bottom: 10rpx; }

/* 风险摘要 */
.report-risk-card { padding: 24rpx; margin-bottom: 18rpx; background: #fff9f0; border-color: #f2d5ad; }
.report-risk-title { font-size: 34rpx; font-weight: 700; margin-bottom: 16rpx; color: #1f2a44; }
.risk-item { font-size: 28rpx; color: #e65100; line-height: 1.6; padding: 8rpx 0; border-bottom: 1rpx solid #f5e6d0; }
.risk-item:last-child { border-bottom: none; }

/* 报告分区标题 */
.report-section-title { font-size: 34rpx; font-weight: 700; margin-bottom: 20rpx; color: #1f2a44; padding-bottom: 12rpx; border-bottom: 2rpx solid #e8ecf1; }

/* 总览指标 */
.metrics-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.metrics-grid-3 { grid-template-columns: repeat(3, 1fr); }
.metric-item { background: #f7f8fb; border-radius: 16rpx; padding: 20rpx; text-align: center; }
.metric-value { font-size: 44rpx; font-weight: 700; }
.metric-label { font-size: 26rpx; color: #6f7b90; margin-top: 6rpx; }

/* 相似标准 */
.similar-item { padding: 16rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.similar-item:last-child { border-bottom: none; }
.similar-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.similar-code { font-size: 28rpx; font-weight: 700; color: #1f2a44; }
.similar-type { font-size: 22rpx; }
.similar-title { font-size: 26rpx; color: #6f7b90; margin-bottom: 8rpx; }
.similar-scores { display: flex; gap: 20rpx; font-size: 24rpx; color: #999; }

/* 问题列表 */
.issue-item { padding: 16rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.issue-item:last-child { border-bottom: none; }
.issue-code { font-size: 28rpx; font-weight: 600; color: #1f2a44; margin-bottom: 6rpx; }
.issue-detail { font-size: 26rpx; color: #e65100; margin-bottom: 4rpx; }

/* 分析结论 */
.tab-section { padding: 16rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.tab-section:last-child { border-bottom: none; }
.tab-label { font-size: 30rpx; font-weight: 700; color: #1f2a44; margin-bottom: 8rpx; }
.conclusion-item { font-size: 26rpx; color: #333; line-height: 1.6; padding: 6rpx 0 6rpx 20rpx; border-left: 4rpx solid #1677ff; margin-bottom: 8rpx; }

/* 风险等级徽章 */
.risk-badge { display: inline-block; font-size: 24rpx; font-weight: 700; padding: 6rpx 18rpx; border-radius: 8rpx; margin-top: 12rpx; }
.risk-high { background: #fde8e8; color: #e74c3c; }
.risk-medium { background: #fef3e2; color: #f39c12; }
.risk-low { background: #e8f8e8; color: #27ae60; }

/* 相似度分值标签 */
.similar-score { font-size: 28rpx; font-weight: 700; color: #e74c3c; margin-left: auto; }

/* 命中详情 */
.match-detail { margin-top: 10rpx; padding: 12rpx; background: #f8f9fb; border-radius: 12rpx; }
.match-label { font-size: 24rpx; font-weight: 600; color: #6f7b90; margin-bottom: 6rpx; }
.match-row { padding: 2rpx 0; }

/* 重复率统计 */
.dup-stats { margin-top: 12rpx; }
.dup-stat { font-size: 26rpx; color: #6f7b90; padding: 4rpx 0; }

/* 解锁/导出 */
.unlock-card, .export-card { text-align: center; padding: 40rpx 24rpx; }
.unlock-title { font-size: 38rpx; font-weight: 700; margin-bottom: 10rpx; }

/* 底部固定解锁栏 */
.unlock-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 20rpx 30rpx; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.08); padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); z-index: 100; box-sizing: border-box; }
.unlock-bar-info { flex: 1; }
.unlock-bar-title { font-size: 30rpx; font-weight: 700; color: #1f2a44; }
.unlock-bar-desc { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.unlock-bar-btn { background: linear-gradient(135deg, #1677ff, #4096ff); color: #fff; font-size: 28rpx; font-weight: 700; padding: 18rpx 32rpx; border-radius: 44rpx; flex-shrink: 0; margin-left: 20rpx; }

/* 页面安全留白（为固定底部栏留空间） */
.page-shell { padding-bottom: 140rpx; }

/* 有效性标签 */
.status-tag { display: inline-block; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin-top: 8rpx; font-weight: 600; }
.status-tag-valid { background: #e8f8e8; color: #27ae60; }
.status-tag-obsolete { background: #fde8e8; color: #e74c3c; }
.status-tag-upcoming { background: #e8f0fe; color: #1677ff; }
.status-tag-default { background: #f5f5f5; color: #999; }

/* 来源徽章 */
.issue-code-row { display: flex; align-items: center; margin-bottom: 6rpx; }
.source-badge { font-size: 20rpx; padding: 2rpx 10rpx; border-radius: 8rpx; margin-left: 12rpx; font-weight: 500; }
.source-badge-main { background: #e6f7e6; color: #27ae60; }
.source-badge-meta { background: #e8f0fe; color: #1677ff; }

/* 行业标准格局 */
.landscape-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.landscape-stat { background: #f7f8fb; border-radius: 16rpx; padding: 20rpx; text-align: center; }
.landscape-value { font-size: 44rpx; font-weight: 700; }
.landscape-label { font-size: 26rpx; color: #6f7b90; margin-top: 6rpx; }

/* 免责声明 */
.disclaimer-card { background: #fafafa; border-color: #f0f0f0; }
.disclaimer-title { font-size: 26rpx; font-weight: 700; color: #595959; margin-bottom: 16rpx; }
.disclaimer-text { font-size: 22rpx; color: #8c8c8c; line-height: 1.7; margin-bottom: 10rpx; }
.disclaimer-text:last-child { margin-bottom: 0; }

/* 进度条 */
.progress-bar { height: 8rpx; background: #edf0f5; border-radius: 4rpx; margin: 12rpx 0; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 4rpx; transition: width 0.3s; }
.fill-high { background: #f5222d; }
.fill-mid { background: #fa8c16; }
.fill-low { background: #52c41a; }

/* 相似度评分徽章 */
.score-badge { padding: 4rpx 16rpx; border-radius: 20rpx; font-size: 28rpx; font-weight: 700; }
.score-high { background: #fee2e2; color: #dc2626; }
.score-mid { background: #fef3c7; color: #d97706; }
.score-warn { background: #fef9c3; color: #ca8a04; }
.score-low { background: #dcfce7; color: #16a34a; }

/* 综合分析卡片颜色 */
.conclusion-card { padding: 16rpx 20rpx; margin-bottom: 12rpx; border-radius: 12rpx; font-size: 28rpx; line-height: 1.6; }
.conclusion-warn { background: #fff7e6; border-left: 6rpx solid #fa8c16; color: #ad6800; }
.conclusion-ok { background: #f6ffed; border-left: 6rpx solid #52c41a; color: #389e0d; }
.conclusion-info { background: #e6f7ff; border-left: 6rpx solid #1677ff; color: #096dd9; }

/* FAILED / PROCESSING 状态页 */
.report-status-card { text-align: center; padding: 60rpx 32rpx; }
.status-icon { font-size: 72rpx; margin-bottom: 20rpx; }
.status-icon.processing { animation: pulse 1.5s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
.status-title { font-size: 36rpx; font-weight: 700; color: #1f2a44; margin-bottom: 12rpx; }
.status-desc { font-size: 28rpx; color: #6f7b90; margin-bottom: 8rpx; }
.status-tips { font-size: 26rpx; color: #999; }
.report-status-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }

/* 空结果/低质量提示 */
.empty-result-card { text-align: center; padding: 48rpx 32rpx; }
.empty-result-icon { font-size: 60rpx; margin-bottom: 16rpx; }
.empty-result-title { font-size: 34rpx; font-weight: 700; color: #1f2a44; margin-bottom: 12rpx; }
.empty-result-desc { font-size: 28rpx; color: #6f7b90; margin-bottom: 16rpx; }
.empty-result-tips { text-align: left; font-size: 26rpx; color: #6f7b90; line-height: 2; }
.low-quality-alert { background: #fff7e6; border-color: #ffe58f; }
.low-quality-text { font-size: 28rpx; color: #ad6800; line-height: 1.6; }

/* 结构完整性子模块 */
.structure-tag { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; margin-left: 16rpx; font-weight: 500; vertical-align: middle; }
.tag-ok { background: #e8f8e8; color: #27ae60; }
.tag-warn { background: #fff7e6; color: #fa8c16; }
.structure-sub { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f2f5; }
.structure-sub-title { font-size: 28rpx; font-weight: 600; color: #fa8c16; margin-bottom: 10rpx; }

/* 图谱空状态 */
.graph-empty { text-align: center; padding: 32rpx 0; }
.graph-node-tag { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 6rpx; margin-left: 8rpx; }
.tag-red { background: #fee2e2; color: #dc2626; }

/* 文件对比摘要（1对1报告） */
.pair-summary-files { margin-bottom: 20rpx; }
.pair-summary-file { font-size: 26rpx; color: #304255; line-height: 1.8; }
.pair-summary-scores { border-top: 1rpx solid #edf2f6; padding-top: 16rpx; }
.pair-score-row { display: flex; justify-content: space-between; padding: 8rpx 0; }
.pair-score-label { font-size: 26rpx; color: #677586; }
.pair-score-value { font-size: 26rpx; font-weight: 700; color: #304255; }
