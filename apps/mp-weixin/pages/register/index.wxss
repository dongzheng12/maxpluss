/* 销售专属注册欢迎页 — 深色赛博风，与 H5 /s/:salesCode 风格一致 */
page {
  background: #0a0f1c;
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

/* Logo 容器：白底圆角，突出黑色 logo mark（小程序 image 不支持 filter invert） */
.logo-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.25);
}
.logo {
  width: 96rpx;
  height: 96rpx;
}

.title {
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.subtitle {
  color: #94a3b8;
  font-size: 28rpx;
}

/* 销售归因提示卡 */
.tip-card {
  background: rgba(59, 130, 246, 0.08);
  border: 2rpx solid rgba(59, 130, 246, 0.3);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 40rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  color: #cbd5e1;
  font-size: 28rpx;
  line-height: 1.7;
}
.tip-main { margin-bottom: 8rpx; }
.tip-gift { font-size: 30rpx; }
.tip-highlight {
  color: #60a5fa;
  font-weight: 600;
}

.tab-switcher {
  display: flex;
  width: 100%;
  background: rgba(148, 163, 184, 0.14);
  border: 2rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 36rpx;
  box-sizing: border-box;
}
.tab-item {
  flex: 1;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
}
.tab-active {
  color: #fff;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.88), rgba(6, 182, 212, 0.88));
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.22);
}

/* 价值点 */
.benefits {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}
.benefit-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.benefit-icon {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #3b82f6, #06b6d4);
  border-radius: 4rpx;
  flex-shrink: 0;
}
.benefit-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
}

.agreement-row {
  width: 100%;
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.agreement-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid rgba(203, 213, 225, 0.55);
  border-radius: 6rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.agreement-checkbox.checked {
  background: #60a5fa;
  border-color: #60a5fa;
  position: relative;
}

.agreement-checkbox.checked::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 2rpx;
  width: 8rpx;
  height: 16rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(45deg);
}

.agreement-text {
  flex: 1;
  font-size: 24rpx;
  color: rgba(226, 232, 240, 0.76);
  line-height: 1.6;
}

.agreement-link {
  color: #93c5fd;
}

/* 微信授权按钮 */
.auth-btn {
  background: linear-gradient(135deg, #3b82f6, #06b6d4);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 0;
  width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
  border: none;
}
.auth-btn::after { border: none; }
.auth-btn[disabled] {
  opacity: 0.7;
}

.enterprise-card {
  width: 100%;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.72);
  border: 2rpx solid rgba(96, 165, 250, 0.28);
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
}
.enterprise-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.enterprise-desc {
  color: #cbd5e1;
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 28rpx;
}
.enterprise-login-btn {
  margin-bottom: 20rpx;
}
.ghost-btn {
  width: 100%;
  color: #93c5fd;
  background: rgba(59, 130, 246, 0.08);
  border: 2rpx solid rgba(147, 197, 253, 0.32);
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
}
.ghost-btn::after { border: none; }

.tips-footer {
  margin-top: auto;
  padding-top: 40rpx;
  color: #64748b;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.8;
}
