<view class="page-shell">
  <view class="section-card settings-card">
    <view wx:if="{{user}}" class="settings-row" bindtap="goChangePassword"><text>修改密码</text><text class="list-arrow">›</text></view>
    <view class="settings-row" bindtap="goNotificationSettings"><text>消息通知</text><text class="list-arrow">›</text></view>
    <view class="settings-row" bindtap="goPrivacy"><text>隐私政策</text><text class="list-arrow">›</text></view>
    <view class="settings-row" bindtap="goTerms"><text>用户协议</text><text class="list-arrow">›</text></view>
    <view class="settings-row" bindtap="goService"><text>联系客服</text><text class="list-arrow">›</text></view>
  </view>

  <view wx:if="{{user}}" class="ghost-btn" bindtap="logout">退出登录</view>
</view>
