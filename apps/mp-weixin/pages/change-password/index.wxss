.cp-page {
  padding: 32rpx 24rpx;
  min-height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}
.cp-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}

.cp-tip {
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 26rpx;
  line-height: 1.5;
}
.cp-group {
  margin-bottom: 32rpx;
}
.cp-label {
  font-size: 26rpx;
  color: #5b6478;
  display: block;
  margin-bottom: 12rpx;
}
.cp-input {
  height: 88rpx;
  line-height: 88rpx;
  border: 1rpx solid #e0e4ea;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  background: #fafbfc;
}
.cp-submit {
  margin-top: 16rpx;
  background: #3b6288;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}
.cp-submit[disabled] {
  background: #c0c6d0;
  color: #fff;
}
