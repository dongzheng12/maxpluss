/* ═══ outline 页 — 大厂级 UI ═══ */

/* 输入卡片 */
.input-card { padding: 32rpx; margin-bottom: 24rpx; }

.field-group { margin-bottom: 28rpx; }
.field-label {
  font-size: 26rpx; font-weight: 600; color: #3d4d66;
  margin-bottom: 14rpx; letter-spacing: 0.5rpx;
}

/* 下拉选择器 */
.select-box {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; border-radius: 16rpx;
  background: #f5f7fa; border: 2rpx solid #e8ecf2;
  transition: all 0.2s;
}
.select-box:active { border-color: #2b63f6; background: #f0f4ff; }
.select-text { font-size: 28rpx; color: #99a3b4; }
.select-text.selected { color: #1a2236; font-weight: 600; }
.select-arrow {
  font-size: 24rpx; color: #bfc8d6;
  transform: rotate(90deg);
}

/* 文本域 */
.textarea-wrap {
  padding: 20rpx 24rpx 12rpx;
  border-radius: 16rpx; background: #f5f7fa;
  border: 2rpx solid #e8ecf2; transition: all 0.2s;
}
.textarea-wrap.focus { border-color: #2b63f6; background: #fafbff; box-shadow: 0 0 0 4rpx rgba(43,99,246,0.08); }
.outline-textarea {
  width: 100%; min-height: 120rpx;
  font-size: 28rpx; line-height: 1.7; color: #1a2236;
  background: transparent; box-sizing: border-box;
}
.char-count {
  text-align: right; font-size: 22rpx; color: #c0c8d4;
  margin-top: 4rpx; padding-bottom: 4rpx;
}

/* 生成按钮 */
.gen-btn {
  margin-top: 8rpx; height: 96rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, #2b63f6 0%, #4f8cff 100%);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(43,99,246,0.25);
}
.gen-btn:active { transform: scale(0.98); opacity: 0.9; }
.gen-btn.disabled { background: #d6dbe4; box-shadow: none; }
.gen-btn-text { font-size: 30rpx; font-weight: 700; color: #fff; letter-spacing: 2rpx; }

/* 快捷示例 */
.example-section { margin-top: 28rpx; }
.example-label { font-size: 22rpx; color: #b0b8c8; margin-bottom: 12rpx; }
.example-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.example-tag {
  padding: 12rpx 24rpx; border-radius: 999rpx;
  background: #f5f7fa; border: 1rpx solid #e8ecf2;
  font-size: 24rpx; color: #5c6b82;
  transition: all 0.15s;
}
.example-tag:active { background: #edf3ff; color: #2b63f6; border-color: #c5d5ff; }

/* ═══ 模板 + 章节数 ═══ */
.result-meta-card { padding: 28rpx 24rpx; margin-bottom: 24rpx; }
.meta-simple { }
.meta-template { font-size: 30rpx; font-weight: 700; color: #1a2236; margin-bottom: 8rpx; }
.meta-count { font-size: 24rpx; color: #99a3b4; }

/* ═══ 大纲树卡片 ═══ */
.outline-card { padding: 28rpx 24rpx; margin-bottom: 24rpx; }

.card-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24rpx;
}
.card-header-left { display: flex; align-items: center; gap: 12rpx; }
.card-header-icon {
  width: 48rpx; height: 48rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #fff;
}
.card-header-icon.blue { background: linear-gradient(135deg, #2b63f6, #4f8cff); }
.card-header-icon.orange { background: linear-gradient(135deg, #f06a00, #ff9a44); }
.card-header-icon.green { background: linear-gradient(135deg, #0aa649, #34d399); }
.card-header-title { font-size: 32rpx; font-weight: 700; color: #1a2236; }
.card-header-badge {
  padding: 6rpx 18rpx; border-radius: 999rpx;
  background: #edf3ff; color: #2b63f6;
  font-size: 22rpx; font-weight: 600;
}

.legend-row { display: flex; gap: 16rpx; }
.legend-item { display: flex; align-items: center; gap: 6rpx; font-size: 20rpx; color: #99a3b4; }
.legend-dot { width: 12rpx; height: 12rpx; border-radius: 4rpx; }
.legend-dot.blue { background: #2b63f6; }
.legend-dot.gray { background: #d0d5dd; }

/* 条款项 */
.clause-item { margin-bottom: 12rpx; border-radius: 16rpx; overflow: hidden; }

.clause-head {
  display: flex; align-items: center; gap: 12rpx;
  padding: 22rpx 20rpx; position: relative;
}
.clause-head:active { opacity: 0.85; }

.clause-item.editable .clause-head { background: #f0f5ff; }
.clause-item.fixed .clause-head { background: #f7f8fb; }

.clause-indicator {
  width: 6rpx; height: 100%; position: absolute; left: 0; top: 0;
  border-radius: 0 6rpx 6rpx 0;
}
.clause-item.editable .clause-indicator { background: #2b63f6; }
.clause-item.fixed .clause-indicator { background: #d0d5dd; }

.clause-number {
  font-size: 26rpx; font-weight: 700; min-width: 56rpx;
  font-variant-numeric: tabular-nums;
}
.clause-item.editable .clause-number { color: #2b63f6; }
.clause-item.fixed .clause-number { color: #99a3b4; }

.clause-title { font-size: 28rpx; font-weight: 600; flex: 1; }
.clause-item.editable .clause-title { color: #1a2236; }
.clause-item.fixed .clause-title { color: #667389; }

.clause-fixed-tag {
  padding: 4rpx 14rpx; border-radius: 8rpx;
  background: #eef1f6; color: #99a3b4;
  font-size: 20rpx; font-weight: 500; flex-shrink: 0;
}

.clause-arrow {
  font-size: 22rpx; color: #bfc8d6;
  transition: transform 0.25s ease; display: inline-block;
}
.clause-arrow.expanded { transform: rotate(90deg); }

/* 展开内容 */
.clause-body { padding: 16rpx 20rpx 20rpx 28rpx; }
.clause-content {
  font-size: 26rpx; line-height: 1.75; color: #40506b;
  padding: 18rpx 20rpx; background: #fafbfe; border-radius: 14rpx;
  margin-bottom: 12rpx; white-space: pre-wrap;
  border: 1rpx solid #eef1f6;
}
.clause-note {
  display: flex; align-items: flex-start; gap: 10rpx;
  font-size: 24rpx; color: #e68a00; line-height: 1.6;
  padding: 14rpx 18rpx; background: #fffbf0; border-radius: 14rpx;
  margin-bottom: 12rpx; border: 1rpx solid #fff0d4;
}
.note-icon {
  width: 32rpx; height: 32rpx; border-radius: 50%;
  background: #ffd666; color: #fff; font-size: 20rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 2rpx;
}

/* 子条款 */
.child-item { margin-top: 10rpx; margin-left: 20rpx; }
.child-head {
  display: flex; align-items: center; gap: 10rpx;
  padding: 16rpx 14rpx; border-radius: 12rpx;
  background: #fafbfd;
}
.child-head:active { background: #f0f2f6; }
.child-number { font-size: 24rpx; font-weight: 700; color: #667389; min-width: 64rpx; font-variant-numeric: tabular-nums; }
.child-title { font-size: 24rpx; color: #40506b; flex: 1; }
.child-arrow {
  font-size: 20rpx; color: #bfc8d6;
  transition: transform 0.25s ease; display: inline-block;
}
.child-arrow.expanded { transform: rotate(90deg); }
.child-body { padding: 10rpx 10rpx 10rpx 44rpx; }

/* 规范性引用 */
.ref-section { margin-top: 16rpx; }
.ref-section-title {
  font-size: 22rpx; font-weight: 600; color: #99a3b4;
  margin-bottom: 10rpx; text-transform: uppercase; letter-spacing: 1rpx;
}
.ref-item {
  display: flex; flex-wrap: wrap; gap: 8rpx 14rpx; padding: 12rpx 16rpx;
  font-size: 24rpx; border-bottom: 1rpx solid #f0f2f6;
  align-items: center;
}
.ref-item:last-child { border-bottom: none; }
.ref-code { color: #2b63f6; font-weight: 600; white-space: nowrap; }
.ref-name { color: #40506b; flex: 1; line-height: 1.5; }

/* ═══ 附录 ═══ */
.appendix-card { padding: 28rpx 24rpx; margin-bottom: 24rpx; }
.appendix-item {
  display: flex; gap: 16rpx; padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f6; align-items: flex-start;
}
.appendix-item:last-child { border-bottom: none; }
.appendix-type {
  padding: 6rpx 16rpx; border-radius: 10rpx;
  font-size: 22rpx; font-weight: 600; flex-shrink: 0; margin-top: 2rpx;
}
.appendix-type.normative { background: #edf3ff; color: #2b63f6; }
.appendix-type.informative { background: #f5f5f5; color: #757575; }
.appendix-body { flex: 1; }
.appendix-title { font-size: 26rpx; color: #1a2236; font-weight: 600; line-height: 1.5; }
.appendix-content { font-size: 24rpx; color: #667389; margin-top: 8rpx; line-height: 1.6; }

/* ═══ 关联标准 ═══ */
.related-card { padding: 28rpx 24rpx; margin-bottom: 24rpx; }
.related-item {
  display: flex; align-items: baseline; gap: 14rpx; padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f6; font-size: 26rpx;
}
.related-item:last-child { border-bottom: none; }
.related-code { color: #2b63f6; font-weight: 600; white-space: nowrap; flex-shrink: 0; }
.related-name { color: #40506b; line-height: 1.5; flex: 1; }

/* ═══ 空状态 ═══ */
.empty-state { padding: 100rpx 40rpx 60rpx; text-align: center; }
.empty-illustration { margin-bottom: 32rpx; }
.empty-circle {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(135deg, #edf3ff, #f5f0ff);
  display: inline-flex; align-items: center; justify-content: center;
}
.empty-glyph { font-size: 52rpx; color: #2b63f6; opacity: 0.6; }
.empty-text-main { font-size: 30rpx; color: #3d4d66; font-weight: 600; margin-bottom: 8rpx; }
.empty-text-sub { font-size: 24rpx; color: #99a3b4; }

/* ═══ 错误 ═══ */
.error-toast {
  display: flex; align-items: center; gap: 12rpx;
  margin: 24rpx 0; padding: 24rpx 28rpx;
  background: #fef0f0; border: 1rpx solid #fdd; color: #e54545;
  border-radius: 18rpx; font-size: 26rpx;
}
.error-icon {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #e54545; color: #fff; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
