.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 表单 */
.form-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.form-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
}

.form-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 12rpx;
  margin-bottom: 32rpx;
  line-height: 1.6;
}

.form-group {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}

/* iOS 微信原生 input 必须显式 height 才能让 hit-area 等于视觉区域，
   只靠 padding 撑高度会导致整框可见但只有顶部一窄条能点（参考 mp/login
   commit 57c4b44 同根因修复）。textarea 不受此影响，单独 min-height。 */
.input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.6;
  box-sizing: border-box;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #3d3d3d;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 16rpx;
  padding: 0;
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  background: #3d3d3d;
  color: #ffffff;
  opacity: 0.7;
}

.footer-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  margin-top: 24rpx;
  line-height: 1.6;
}

/* 成功态 */
.success-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 0;
}

.success-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #e8f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.success-check {
  font-size: 72rpx;
  color: #2e7d32;
  font-weight: 700;
  line-height: 1;
}

.success-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 60rpx;
  padding: 0 40rpx;
}

.btn-home {
  width: 60%;
  height: 88rpx;
  line-height: 88rpx;
  background: #3d3d3d;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0;
}

.btn-home::after {
  border: none;
}
