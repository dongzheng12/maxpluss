.page { background: #f5f5f7; min-height: 100vh; padding-bottom: 200rpx; }

.loading, .error {
  padding: 60rpx 32rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
.error { color: #f5222d; }

.banner-overdue {
  background: #fff1f0;
  color: #f5222d;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  text-align: center;
}

.card {
  background: #fff;
  margin: 16rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}

.task-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 16rpx;
}

.assignee-status {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  display: inline-block;
  background: #f0f0f0;
  color: #666;
}
.status-PENDING, .status-IN_PROGRESS { background: #e6f4ff; color: #1677ff; }
.status-PENDING_REVIEW { background: #fff7e6; color: #fa8c16; }
.status-REJECTED { background: #fff1f0; color: #f5222d; }
.status-COMPLETED { background: #f6ffed; color: #52c41a; }

.mode-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}
.mode-tag {
  font-size: 22rpx;
  color: #1677ff;
  background: #e6f4ff;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
.inline-tags { margin-top: 12rpx; }
.requirement-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.requirement-row:first-of-type { border-top: none; }
.requirement-title {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
  line-height: 42rpx;
}
.req-index {
  color: #1677ff;
  margin-right: 10rpx;
}
.required { color: #f5222d; }
.requirement-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 38rpx;
  color: #64748b;
}
.hint-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #64748b;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  margin: 16rpx 0 8rpx;
}
.section-title:first-child { margin-top: 0; }

.text-block {
  font-size: 28rpx;
  color: #333;
  line-height: 44rpx;
  white-space: pre-wrap;
  word-break: break-all;
}
.muted { color: #999; }
.small { font-size: 24rpx; }
.clause-no { color: #666; }

.meta-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.meta-label { color: #999; font-size: 26rpx; }
.meta-value { color: #444; font-size: 26rpx; }

.field-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.field-row:first-of-type { border-top: none; }
.field-row-block {
  display: block;
}
.field-value-block {
  display: block;
  margin-top: 8rpx;
  line-height: 42rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

.timeline-lite-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #f5f5f5;
}
.timeline-lite-row:first-of-type { border-top: none; }
.timeline-lite-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1677ff;
  margin-top: 12rpx;
  flex-shrink: 0;
}
.timeline-lite-label {
  width: 100rpx;
  color: #666;
  font-size: 26rpx;
  flex-shrink: 0;
}
.timeline-lite-value {
  flex: 1;
  color: #333;
  font-size: 26rpx;
  line-height: 40rpx;
  word-break: break-all;
}

/* timeline */
.timeline { padding: 8rpx 0; }
.timeline-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.timeline-item:last-child { border-bottom: none; }
.timeline-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ccc;
  flex-shrink: 0;
}
.status-dot-SUBMITTED { background: #fa8c16; }
.status-dot-APPROVED { background: #52c41a; }
.status-dot-REJECTED { background: #f5222d; }

.timeline-summary {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.version-badge {
  font-size: 24rpx;
  background: #f0f0f0;
  color: #666;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.version-badge.latest {
  background: #1677ff;
  color: #fff;
}
.sub-status {
  font-size: 22rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}
.sub-status-SUBMITTED { background: #fff7e6; color: #fa8c16; }
.sub-status-APPROVED { background: #f6ffed; color: #52c41a; }
.sub-status-REJECTED { background: #fff1f0; color: #f5222d; }
.submit-time { color: #999; font-size: 22rpx; }
.toggle { color: #1677ff; font-size: 24rpx; }

.timeline-body {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 8rpx;
}

.reject-comment {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #f0f0f0;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.action-bar button { width: 100%; }
.btn-quiz {
  background: #f0f5ff;
  color: #1677ff;
  border: 1rpx solid #adc6ff;
}
