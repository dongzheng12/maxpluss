<wxs src="../../../utils/filters.wxs" module="filters" />
<view class="page">
  <view class="top-bar">
    <text class="top-bar-title">我的任务</text>
    <text class="top-bar-action" bindtap="goChangePwd">修改密码</text>
  </view>
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >{{item.label}}</view>
  </view>

  <view class="list" wx:if="{{items.length > 0}}">
    <view
      wx:for="{{items}}"
      wx:key="assigneeId"
      class="card"
      data-id="{{item.task.id}}"
      bindtap="goDetail"
    >
      <view class="card-header">
        <text class="card-title">{{item.task.title}}</text>
        <text class="card-overdue" wx:if="{{item.isOverdue}}">已逾期</text>
      </view>
      <view class="card-meta">
        <text class="meta-label">来源要求：</text>
        <text class="meta-value">{{item.task.requirement.title}}</text>
      </view>
      <view class="card-meta">
        <text class="meta-label">截止：</text>
        <text class="meta-value">{{item.task.deadlineAt}}</text>
      </view>
      <view class="card-meta" wx:if="{{item.submitFormSummary}}">
        <text class="meta-label">提交：</text>
        <text class="meta-value">{{item.submitFormSummary}}</text>
      </view>
      <view class="card-footer">
        <text class="status status-{{item.assigneeStatus}}">{{filters.statusLabel(item.assigneeStatus)}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{empty && !loading}}">
    <text>暂无任务</text>
  </view>

  <view class="footer" wx:if="{{items.length > 0 && finished}}">
    <text>没有更多了</text>
  </view>
</view>
