.page {
  background: #f5f5f7;
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.center-tip {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
.center-tip.error { color: #f5222d; }

/* ── 答题头部 ── */
.quiz-header {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.quiz-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2535;
  margin-bottom: 8rpx;
}
.quiz-count {
  font-size: 24rpx;
  color: #999;
}

/* ── 题目卡片 ── */
.question-list { padding: 0 0 16rpx 0; }
.question-card {
  background: #fff;
  margin: 16rpx 0;
  padding: 28rpx 32rpx;
  border-radius: 16rpx;
}

.q-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.q-no {
  font-size: 28rpx;
  font-weight: 700;
  color: #1677ff;
}
.q-type-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.badge-single { background: #e6f4ff; color: #1677ff; }
.badge-multi  { background: #fff7e6; color: #fa8c16; }

.q-score {
  margin-left: auto;
  font-size: 22rpx;
  color: #999;
}

.q-text {
  font-size: 30rpx;
  color: #1a2535;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* ── 选项 ── */
.opt-list { display: flex; flex-direction: column; gap: 16rpx; }
.opt-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #f7f9fc;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}
.opt-item.opt-selected {
  background: #e6f4ff;
  border-color: #1677ff;
}
.opt-letter {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e8ecf0;
  color: #555;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.opt-letter.letter-selected {
  background: #1677ff;
  color: #fff;
}
.opt-text {
  font-size: 28rpx;
  color: #1a2535;
  line-height: 1.5;
  flex: 1;
  padding-top: 8rpx;
}

/* ── 提交栏 ── */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
}
.submit-bar button { width: 100%; }

/* ── 结果头部 ── */
.result-header {
  padding: 60rpx 32rpx 40rpx;
  text-align: center;
  margin-bottom: 8rpx;
}
.result-pass { background: linear-gradient(135deg, #52c41a, #73d13d); }
.result-fail { background: linear-gradient(135deg, #ff4d4f, #ff7875); }

.result-icon {
  font-size: 80rpx;
  color: #fff;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.result-verdict {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 20rpx;
}
.result-score { color: rgba(255,255,255,0.95); margin-bottom: 12rpx; }
.score-num { font-size: 60rpx; font-weight: 900; color: #fff; }
.score-total { font-size: 28rpx; }
.result-stats { font-size: 26rpx; color: rgba(255,255,255,0.85); margin-bottom: 8rpx; }
.pass-hint { font-size: 24rpx; color: rgba(255,255,255,0.75); }

/* ── 结果题目卡 ── */
.verdict-dot {
  font-size: 28rpx;
  font-weight: 700;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dot-correct { background: #f6ffed; color: #52c41a; }
.dot-wrong   { background: #fff1f0; color: #f5222d; }

/* 结果选项 */
.opt-item.opt-correct-ans {
  background: #f6ffed;
  border-color: #52c41a;
}
.opt-item.opt-wrong-ans {
  background: #fff1f0;
  border-color: #f5222d;
}
.opt-letter.letter-correct { background: #52c41a; color: #fff; }
.opt-letter.letter-wrong   { background: #f5222d; color: #fff; }

/* 解析 */
.exp-block {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fffbe6;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #614700;
  line-height: 1.6;
}
.exp-label { font-weight: 600; }
