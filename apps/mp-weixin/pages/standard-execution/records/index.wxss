.page { background: #f5f5f7; min-height: 100vh; padding-bottom: 40rpx; }

.list { padding: 16rpx; }

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
}
.card-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 40rpx;
  margin-bottom: 12rpx;
  /* 摘要最多两行 */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}
.muted { color: #999; }
.small { font-size: 22rpx; }

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #f6ffed;
  color: #52c41a;
}
.status-EXPIRED { background: #fff7e6; color: #fa8c16; }
.status-VOID { background: #fff1f0; color: #f5222d; }

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}
.footer {
  text-align: center;
  padding: 24rpx 0;
  color: #ccc;
  font-size: 24rpx;
}
