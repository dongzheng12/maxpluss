.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}
.loading { text-align: center; color: #999; padding: 80rpx 0; }

.not-ready {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 24rpx;
  text-align: center;
  margin-top: 80rpx;
}
.not-ready-title {
  font-size: 32rpx;
  color: #1f2329;
  margin-bottom: 16rpx;
}
.not-ready-hint {
  font-size: 26rpx;
  color: #86909c;
  line-height: 1.6;
}

.history-banner {
  background: #f0f5ff;
  border: 1rpx solid #adc6ff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.history-tag {
  display: inline-block;
  background: #1677ff;
  color: #fff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}
.history-hint {
  font-size: 26rpx;
  color: #1f2329;
  line-height: 1.6;
}

.header-card {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}
.header-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.4;
}
.header-meta {
  font-size: 26rpx;
  opacity: 0.85;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f1f3;
  padding-bottom: 12rpx;
}

.row {
  display: flex;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.row.block { flex-direction: column; gap: 8rpx; }
.k {
  flex-shrink: 0;
  width: 200rpx;
  color: #86909c;
}
.row.block .k { width: auto; }
.v {
  flex: 1;
  color: #1f2329;
  word-break: break-all;
}
.v.mono {
  font-family: monospace;
  font-size: 28rpx;
  color: #0958d9;
  font-weight: 500;
}
.v.multi {
  white-space: pre-wrap;
  line-height: 1.6;
}
.v.link {
  color: #0958d9;
  word-break: break-all;
}

button {
  margin-top: 12rpx;
}
.ghost-btn {
  background: #fff;
  color: #1677ff;
  border: 1rpx solid #91caff;
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8rpx;
}
.ghost-btn::after { border: none; }
.primary-btn {
  background: #1677ff;
  color: #fff;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 10rpx;
  border: none;
  margin-top: 16rpx;
}
.primary-btn::after { border: none; }

.hint {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 12rpx;
  text-align: center;
  line-height: 1.6;
}

.footer-meta {
  text-align: center;
  font-size: 22rpx;
  color: #86909c;
  margin-top: 16rpx;
}

.expert-row {
  display: block;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx dashed #f0f1f3;
}
.expert-row:last-child { border-bottom: none; }
.expert-name { font-weight: 600; color: #1f2329; }
.expert-meta { color: #86909c; font-size: 24rpx; }
.expert-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  background: #e6f4ff;
  color: #0958d9;
  font-size: 22rpx;
  border-radius: 16rpx;
}

.expert-empty {
  font-size: 26rpx;
  color: #86909c;
  padding: 16rpx 0;
}
