.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
}

.loading { text-align: center; color: #999; padding: 80rpx 0; }

.header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.project {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.4;
}
.tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.tag-default { background: #f0f1f3; color: #666; }
.tag-warning { background: #fff7e6; color: #d48806; }
.tag-processing { background: #e6f4ff; color: #1677ff; }
.tag-cyan { background: #e6fffb; color: #08979c; }
.tag-blue { background: #e6f4ff; color: #0958d9; }
.tag-purple { background: #f9f0ff; color: #531dab; }
.tag-success { background: #f6ffed; color: #389e0d; }

.meta-line {
  font-size: 24rpx;
  color: #86909c;
  margin-bottom: 24rpx;
  font-family: monospace;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f1f3;
  padding-bottom: 12rpx;
}

.row {
  display: flex;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.row.block { flex-direction: column; gap: 8rpx; }
.k {
  flex-shrink: 0;
  width: 200rpx;
  color: #86909c;
}
.row.block .k { width: auto; }
.v {
  flex: 1;
  color: #1f2329;
  word-break: break-all;
}
.v.mono {
  font-family: monospace;
  font-size: 24rpx;
}
.v.multi {
  white-space: pre-wrap;
  line-height: 1.6;
}

.att {
  display: flex;
  flex-direction: column;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}
.att:last-child { border-bottom: none; }
.att-name { font-size: 26rpx; color: #1f2329; }
.att-meta { font-size: 22rpx; color: #86909c; margin-top: 4rpx; }

.hint {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 8rpx;
  text-align: center;
}

.hint-card {
  font-size: 26rpx;
  color: #4e5969;
  background: #f0f5ff;
  text-align: center;
  line-height: 1.6;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f1f3;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.primary-btn {
  background: #1677ff;
  color: #fff;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  border: none;
}
.primary-btn::after { border: none; }
.ghost-btn {
  background: #fff;
  color: #1677ff;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d9d9d9;
}
.ghost-btn::after { border: none; }

.hint-card.success {
  background: #f6ffed;
  color: #389e0d;
}
