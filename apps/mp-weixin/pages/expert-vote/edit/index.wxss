.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 步骤条 */
.step-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.step-num {
  font-size: 28rpx;
  color: #1677ff;
  font-weight: 500;
}
.step-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 6rpx 0 16rpx;
}
.step-bar {
  height: 6rpx;
  background: #f0f1f3;
  border-radius: 3rpx;
  overflow: hidden;
}
.step-bar-inner {
  height: 100%;
  background: #1677ff;
  transition: width 0.3s;
}

/* Card */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.field { margin-bottom: 24rpx; }
.label {
  font-size: 26rpx;
  color: #4e5969;
  margin-bottom: 12rpx;
}
.req {
  color: #f53f3f;
  margin-left: 4rpx;
}

.input, .textarea, .picker {
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #1f2329;
}
.textarea {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: #f7f8fa;
  color: #4e5969;
  font-size: 24rpx;
  border: 1rpx solid transparent;
}
.chip.active {
  background: #e6f4ff;
  color: #1677ff;
  border-color: #91caff;
}

.seg {
  display: flex;
  background: #f7f8fa;
  border-radius: 8rpx;
  overflow: hidden;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #4e5969;
}
.seg-item.active {
  background: #1677ff;
  color: #fff;
}

.hint-inline {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 8rpx;
  line-height: 1.5;
}
.hint-block {
  font-size: 24rpx;
  color: #4e5969;
  background: #f0f5ff;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.att {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}
.att.pending { background: #fffbe6; }
.att-name {
  flex: 1;
  font-size: 24rpx;
  color: #1f2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.att-del { font-size: 24rpx; color: #f53f3f; margin-left: 16rpx; }
.att-pick {
  border: 1rpx dashed #c9cdd4;
  border-radius: 8rpx;
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: #1677ff;
  margin-top: 8rpx;
}

/* 确认页 row */
.row {
  display: flex;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.k {
  flex-shrink: 0;
  width: 200rpx;
  color: #86909c;
}
.v {
  flex: 1;
  color: #1f2329;
  word-break: break-all;
}

.price-card { background: linear-gradient(180deg, #fff 0%, #fff7e6 100%); }
.price-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 12rpx 0;
}
.price-label { color: #86909c; }
.price-value { color: #1f2329; font-weight: 500; }
.price-final {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 1rpx dashed #f0f1f3;
}
.price-final .price-label {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 600;
}
.price-amount {
  font-size: 44rpx;
  color: #f53f3f;
  font-weight: 700;
}

/* 底部 */
.footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f1f3;
  display: flex;
  gap: 12rpx;
}
.footer button {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  border: none;
}
.footer button::after { border: none; }
.ghost-btn {
  background: #fff;
  color: #1677ff;
  border: 1rpx solid #91caff !important;
}
.primary-btn {
  background: #1677ff;
  color: #fff;
}
.primary-btn[disabled],
.ghost-btn[disabled] {
  opacity: 0.5;
}
