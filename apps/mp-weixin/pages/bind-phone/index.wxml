<view class="page-shell">
  <view class="bind-card">
    <view class="bind-title">绑定手机号</view>
    <view class="bind-desc">绑定手机号后可在电脑端使用手机号登录，数据互通</view>

    <view class="form-group">
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-group sms-row">
      <input
        class="form-input sms-input"
        type="number"
        maxlength="6"
        placeholder="短信验证码"
        value="{{smsCode}}"
        bindinput="onSmsCodeInput"
      />
      <button
        class="sms-btn"
        size="mini"
        disabled="{{!phone || smsCountdown > 0 || sendingCode}}"
        loading="{{sendingCode}}"
        bindtap="onSendCode"
      >
        {{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}
      </button>
    </view>

    <button
      class="bind-btn"
      type="primary"
      disabled="{{!phone || !smsCode || loading}}"
      loading="{{loading}}"
      bindtap="onSubmit"
    >
      确认绑定
    </button>

    <view class="skip-link" bindtap="onSkip">暂时跳过</view>
  </view>
</view>
