/* ═══ 扫一扫 ═══ */

/* 首页标题 */
.scan-hero { padding: 16rpx 0 24rpx; }
.scan-hero-title { font-size: 48rpx; font-weight: 800; color: #223247; }
.scan-hero-sub { font-size: 28rpx; color: #9cabbb; margin-top: 4rpx; }

/* 拍照入口 */
.scan-entry {
  display: flex; align-items: center; padding: 32rpx 28rpx;
  margin-bottom: 24rpx; gap: 20rpx;
}
.scan-entry-text { flex: 1; }
.scan-entry-title { font-size: 32rpx; font-weight: 700; color: #223247; margin-bottom: 4rpx; }

/* 相机图标 (CSS) */
.cam-icon { width: 56rpx; height: 48rpx; position: relative; flex-shrink: 0; }
.cam-body {
  width: 52rpx; height: 36rpx; border: 3rpx solid #3b6288; border-radius: 8rpx;
  position: absolute; bottom: 0; display: flex; align-items: center; justify-content: center;
}
.cam-lens { width: 16rpx; height: 16rpx; border: 3rpx solid #3b6288; border-radius: 50%; }
.cam-top {
  width: 20rpx; height: 8rpx; background: #3b6288; border-radius: 4rpx 4rpx 0 0;
  position: absolute; top: 2rpx; left: 16rpx;
}

/* ═══ 历史记录 ═══ */
.hist-wrap { position: relative; overflow: hidden; }
.hist-card {
  background: #fff; padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
  transition: transform 0.25s ease;
}
.hist-swiped { transform: translateX(-140rpx); }
.hist-body { }
.hist-name { font-size: 30rpx; font-weight: 600; color: #223247; margin-bottom: 4rpx; }
.hist-standard { font-size: 26rpx; color: #5d6e7f; margin-bottom: 8rpx; }
.hist-meta-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.hist-pending { color: #e6a23c; }
.hist-failed { color: #f56c6c; }
.hist-sub { font-size: 24rpx; color: #9cabbb; }
.hist-chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.hist-chip-high { background: #e7f7ef; color: #0f9f5f; }
.hist-chip-mid { background: #fff4df; color: #c77b11; }
.hist-chip-verify { background: #eef3ff; color: #4667d9; }
.hist-chip-low { background: #fdecec; color: #d64c4c; }
.hist-chip-good { background: #e7f7ef; color: #0f9f5f; }
.hist-chip-weak { background: #f1f3f6; color: #6b7785; }
.hist-del {
  position: absolute; right: 0; top: 0; bottom: 0; width: 140rpx;
  background: #ff4d4f; color: #fff; font-size: 28rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  transform: translateX(140rpx); transition: transform 0.25s ease;
}
.hist-del-show { transform: translateX(0); }

/* ═══ 加载 ═══ */
.loading-center {
  display: flex; flex-direction: column; align-items: center;
  padding: 200rpx 40rpx 240rpx;
}
.progress-bar { display: flex; align-items: center; margin-bottom: 56rpx; }
.progress-step { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.ps-dot {
  width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center;
  border-radius: 50%; font-size: 24rpx; font-weight: 700;
  background: #edf1f5; color: #b0b8c4; transition: all 0.3s;
}
.ps-on .ps-dot { background: #3b6288; color: #fff; }
.ps-ok .ps-dot { background: #17a34a; color: #fff; }
.ps-label { font-size: 22rpx; color: #b0b8c4; }
.ps-on .ps-label { color: #3b4a5c; font-weight: 600; }
.ps-ok .ps-label { color: #17a34a; }
.ps-line {
  width: 48rpx; height: 4rpx; background: #edf1f5;
  margin: 0 12rpx; margin-bottom: 28rpx; transition: background 0.3s;
}
.ps-line-ok { background: #17a34a; }

.loading-anim {
  width: 48rpx; height: 48rpx; border: 4rpx solid #e8edf2; border-top-color: #3b6288;
  border-radius: 50%; animation: spin 0.7s linear infinite; margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-ok { font-size: 48rpx; color: #17a34a; margin-bottom: 20rpx; }
.loading-label { font-size: 28rpx; color: #7d8a9a; }

/* 错误 */
.err-dot {
  width: 64rpx; height: 64rpx; line-height: 64rpx; text-align: center;
  border-radius: 50%; background: #fff2e7; color: #f06a00;
  font-size: 36rpx; font-weight: 700; margin-bottom: 20rpx;
}
.err-msg { font-size: 28rpx; color: #3b4a5c; text-align: center; line-height: 1.6; margin-bottom: 32rpx; }

/* ═══ 结果页 ═══ */

/* ① 结论卡片 */
.conclusion-card {
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #8b99a8;
  background: #fff;
}
.conclusion-good { border-left-color: #17a34a; }
.conclusion-mid { border-left-color: #c77b11; }
.conclusion-weak { border-left-color: #8b99a8; }
.conclusion-product { font-size: 38rpx; font-weight: 800; color: #223247; margin-bottom: 10rpx; }
.conclusion-line { font-size: 26rpx; color: #5d6e7f; line-height: 1.6; }
.conclusion-good .conclusion-line { color: #0f9f5f; }
.conclusion-mid .conclusion-line { color: #c77b11; }

/* 置信度条（依据段内联） */
.conf-bar {
  width: 160rpx; height: 12rpx; background: #edf1f5; border-radius: 6rpx; overflow: hidden;
}
.conf-bar-inline { flex: 1; }
.conf-fill { height: 100%; background: #17a34a; border-radius: 6rpx; transition: width 0.5s; }
.conf-pct { font-size: 24rpx; font-weight: 700; color: #17a34a; min-width: 70rpx; text-align: right; }
.evidence-card { padding: 28rpx; margin-bottom: 20rpx; }
.evidence-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.evidence-label { font-size: 24rpx; color: #8ea0b2; flex-shrink: 0; min-width: 130rpx; }
.evidence-value { font-size: 24rpx; color: #3b4a5c; text-align: right; }
.evidence-value-multi { flex: 1; text-align: left; line-height: 1.6; }
.evidence-tip {
  font-size: 22rpx;
  line-height: 1.7;
  color: #8b99a8;
  padding-top: 6rpx;
}

/* ③ 分层推荐 — category 警示条 */
.category-warn {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 22rpx 28rpx; margin-bottom: 20rpx;
  background: #fff8e6; border-left: 8rpx solid #f0ad4e;
}
.category-warn-icon {
  width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center;
  border-radius: 50%; background: #f0ad4e; color: #fff;
  font-size: 22rpx; font-weight: 800; flex-shrink: 0; margin-top: 4rpx;
}
.category-warn-text { flex: 1; font-size: 24rpx; color: #8b6914; line-height: 1.6; }

/* ③ 分层推荐 — general 通用方向卡 */
.directions-card { padding: 28rpx; margin-bottom: 20rpx; }
.directions-tip { font-size: 22rpx; color: #8b99a8; margin-bottom: 16rpx; line-height: 1.6; }
.direction-row { display: flex; align-items: flex-start; gap: 14rpx; margin-bottom: 12rpx; }
.direction-bullet {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #5b8ab5; margin-top: 16rpx; flex-shrink: 0;
}
.direction-text { flex: 1; font-size: 26rpx; line-height: 1.6; color: #425466; }

/* ④ 风险提示 */
.risk-card { padding: 24rpx 28rpx; margin-bottom: 20rpx; background: #fafbfc; }
.risk-row { font-size: 24rpx; color: #5d6e7f; line-height: 1.7; margin-bottom: 8rpx; }

/* ⑤ 服务推荐（弱化样式） */
.offer-card {
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  background: #fafbfc;
  border: 2rpx solid #e8edf2;
  box-shadow: none;
}
.offer-title { font-size: 26rpx; font-weight: 700; color: #3b4a5c; margin-bottom: 8rpx; }
.offer-body { font-size: 24rpx; color: #7d8a9a; line-height: 1.6; margin-bottom: 12rpx; }
.offer-cta { font-size: 24rpx; color: #5b8ab5; font-weight: 600; }

/* ═══ 关联图谱 ═══ */
.graph-container {
  position: relative; width: 100%; height: 700rpx;
  display: flex; align-items: center; justify-content: center;
}

/* 连接线 */
.graph-line {
  position: absolute; height: 2rpx; background: #d5e0ea;
  transform-origin: 0 50%; left: 50%; top: 50%; margin-top: -1rpx;
}

/* 中心节点 */
.graph-center-node {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  width: 140rpx; height: 140rpx;
  background: linear-gradient(135deg, #3b6288, #5b8ab5);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 98, 136, 0.25); z-index: 2;
}
.graph-center-text {
  color: #fff; font-size: 24rpx; font-weight: 700;
  text-align: center; line-height: 1.3;
  max-width: 120rpx; overflow: hidden;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}

/* 标准节点 */
.graph-std-node {
  position: absolute; left: 50%; top: 50%;
  margin-left: -70rpx; margin-top: -34rpx;
  width: 140rpx; padding: 10rpx 8rpx;
  background: #fff; border: 2rpx solid #d5e0ea; border-radius: 12rpx;
  text-align: center; z-index: 2;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.std-node-code { font-size: 20rpx; font-weight: 700; color: #3b6288; display: block; margin-bottom: 2rpx; }
.std-node-name {
  font-size: 16rpx; color: #9cabbb; display: block;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 标准列表 */
.std-list-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0; border-bottom: 1rpx solid #f0f2f5;
}
.std-list-row:last-child { border-bottom: none; }
.std-list-left { flex: 1; min-width: 0; }
.std-list-code { font-size: 28rpx; font-weight: 700; color: #3b6288; margin-bottom: 2rpx; }
.std-list-name { font-size: 24rpx; color: #7d8a9a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 识别把握 badge */
.confidence-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  margin-top: 14rpx;
}
.confidence-badge-label { line-height: 1; }
.confidence-high { background: #e7f7ef; color: #0f9f5f; }
.confidence-mid { background: #fff4df; color: #c77b11; }
.confidence-low { background: #f1f3f6; color: #6b7785; }
.confidence-tip {
  font-size: 22rpx;
  color: #8ea0b2;
  margin-top: 10rpx;
  line-height: 1.5;
}

/* 购买建议主结论卡 */
.advice-main-card {
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #8b99a8;
}
.advice-main-strong { border-left-color: #17a34a; }
.advice-main-moderate { border-left-color: #d4a017; }
.advice-main-weak { border-left-color: #8b99a8; }
.advice-kicker {
  font-size: 20rpx;
  color: #a8b4c2;
  margin-bottom: 6rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
.advice-main-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #223247;
  line-height: 1.3;
  margin-bottom: 10rpx;
}
.advice-main-strong .advice-main-title { color: #0f7b3f; }
.advice-main-moderate .advice-main-title { color: #8b6914; }
.advice-main-sub {
  margin-bottom: 18rpx;
}
.confidence-inline {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}
.confidence-inline-high { background: #e7f7ef; color: #0f9f5f; }
.confidence-inline-mid { background: #fff4df; color: #c77b11; }
.confidence-inline-low { background: #f1f3f6; color: #6b7785; }
.advice-main-body {
  font-size: 30rpx;
  font-weight: 600;
  color: #304255;
  line-height: 1.6;
  margin-bottom: 12rpx;
}
.advice-main-basis {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf2f6;
  font-size: 24rpx;
  color: #5d6e7f;
  line-height: 1.5;
}
.secondary-action-row { display: flex; justify-content: center; gap: 32rpx; margin-top: 16rpx; }
.secondary-action { font-size: 26rpx; color: #5b8ab5; }
