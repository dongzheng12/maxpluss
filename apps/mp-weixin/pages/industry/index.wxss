/* ═══ industry 页 — 大厂级 UI ═══ */

/* 搜索卡片 */
.search-card { padding: 32rpx; margin-bottom: 24rpx; }

.search-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; align-items: center; }
.search-input-wrap {
  flex: 1; display: flex; align-items: center; gap: 14rpx;
  padding: 0 24rpx; height: 80rpx; border-radius: 16rpx;
  background: #f5f7fa; border: 2rpx solid #e8ecf2;
}
.search-input-wrap:active { border-color: #2b63f6; }
.search-icon-glyph { font-size: 32rpx; color: #bfc8d6; flex-shrink: 0; }
.search-input { flex: 1; font-size: 28rpx; color: #1a2236; }

/* 右侧行业下拉入口 */
.search-ind-trigger {
  height: 80rpx; padding: 0 20rpx; border-radius: 16rpx;
  background: #edf3ff; border: 2rpx solid #d4dffa;
  display: flex; align-items: center; gap: 8rpx;
  flex-shrink: 0;
}
.search-ind-trigger:active { background: #dce8ff; }
.ind-trigger-text { font-size: 26rpx; color: #2b63f6; font-weight: 600; white-space: nowrap; }
.ind-trigger-icon { font-size: 24rpx; color: #2b63f6; }

/* 热门标签 */
.hot-section { }
.hot-label { font-size: 22rpx; color: #b0b8c8; margin-bottom: 12rpx; }
.hot-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.hot-tag {
  padding: 12rpx 26rpx; border-radius: 999rpx;
  background: #f5f7fa; border: 1rpx solid #e8ecf2;
  font-size: 24rpx; color: #5c6b82;
}
.hot-tag:active { background: #edf3ff; color: #2b63f6; border-color: #c5d5ff; }

/* ═══ 统计卡片 ═══ */
.stats-row {
  display: flex; gap: 16rpx; padding: 0 0; margin-bottom: 24rpx;
}
.stat-box {
  flex: 1; background: #fff; border-radius: 20rpx;
  padding: 28rpx 16rpx; text-align: center;
  border: 1rpx solid rgba(209,214,222,0.6);
  box-shadow: 0 4rpx 16rpx rgba(28,44,73,0.04);
}
.stat-num {
  font-size: 44rpx; font-weight: 800; margin-bottom: 4rpx;
  font-variant-numeric: tabular-nums;
}
.stat-num.total { color: #1a2236; }
.stat-num.mandatory { color: #2b63f6; }
.stat-num.recommended { color: #0aa649; }
.stat-desc { font-size: 22rpx; color: #99a3b4; }

/* ═══ 类型筛选 ═══ */
.filter-card { padding: 20rpx 0 20rpx 24rpx; margin-bottom: 24rpx; }
.filter-scroll { white-space: nowrap; }
.filter-row { display: inline-flex; gap: 14rpx; padding-right: 24rpx; }
.filter-chip {
  padding: 14rpx 28rpx; border-radius: 999rpx;
  background: #f5f7fa; border: 1rpx solid #e8ecf2;
  font-size: 24rpx; color: #5c6b82; white-space: nowrap;
  display: inline-flex; align-items: center;
}
.filter-chip.active {
  background: linear-gradient(135deg, #2b63f6, #4f8cff);
  color: #fff; border-color: transparent; font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(43,99,246,0.2);
}
.filter-count { margin-left: 4rpx; }

/* ═══ 标准列表 ═══ */
.list-card { padding: 28rpx 24rpx; margin-bottom: 24rpx; }
.list-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20rpx;
}
.list-title { font-size: 30rpx; font-weight: 700; color: #1a2236; }
.list-badge {
  padding: 6rpx 18rpx; border-radius: 999rpx;
  background: #edf3ff; color: #2b63f6;
  font-size: 22rpx; font-weight: 600;
}

.std-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 0; border-bottom: 1rpx solid #f0f2f6;
}
.std-item:last-child { border-bottom: none; }
.std-item:active { background: #fafbfe; margin: 0 -24rpx; padding: 24rpx; border-radius: 12rpx; }

.std-left { flex: 1; min-width: 0; }
.std-code {
  font-size: 26rpx; font-weight: 700; color: #2b63f6;
  margin-bottom: 6rpx; font-variant-numeric: tabular-nums;
}
.std-name {
  font-size: 26rpx; color: #1a2236; line-height: 1.6;
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}

.std-right { flex-shrink: 0; text-align: right; }
.std-status {
  display: inline-block;
  padding: 6rpx 18rpx; border-radius: 999rpx;
  font-size: 22rpx; font-weight: 500; white-space: nowrap;
  background: #f5f5f5; color: #757575;
}
.status-active { background: #e6f8ee; color: #0aa649; }
.status-upcoming { background: #e3f2fd; color: #1565c0; }
.std-dates { margin-top: 8rpx; }
.std-date { display: block; font-size: 20rpx; color: #99a3b4; line-height: 1.6; }

.empty-inline {
  padding: 60rpx 20rpx; text-align: center;
  color: #99a3b4; font-size: 26rpx;
}

/* ═══ 分页 ═══ */
.pagination {
  display: flex; justify-content: center; align-items: center;
  gap: 32rpx; padding: 16rpx 0 24rpx;
}
.page-btn {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: #fff; border: 1rpx solid #e0e5ec;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.page-btn:active { background: #f5f7fa; }
.page-btn.disabled { opacity: 0.25; }
.page-arrow { font-size: 28rpx; color: #3d4d66; }
.page-info { font-size: 26rpx; color: #99a3b4; font-variant-numeric: tabular-nums; }

/* ═══ 空状态 ═══ */
.empty-state { padding: 100rpx 40rpx 60rpx; text-align: center; }
.empty-illustration { margin-bottom: 32rpx; }
.empty-circle {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(135deg, #edf3ff, #f5f0ff);
  display: inline-flex; align-items: center; justify-content: center;
}
.empty-glyph { font-size: 52rpx; color: #2b63f6; opacity: 0.6; }
.empty-text-main { font-size: 30rpx; color: #3d4d66; font-weight: 600; margin-bottom: 8rpx; }
.empty-text-sub { font-size: 24rpx; color: #99a3b4; }

/* ═══ 错误 ═══ */
.error-toast {
  display: flex; align-items: center; gap: 12rpx;
  margin: 24rpx 0; padding: 24rpx 28rpx;
  background: #fef0f0; border: 1rpx solid #fdd; color: #e54545;
  border-radius: 18rpx; font-size: 26rpx;
}
.error-icon {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #e54545; color: #fff; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

/* ═══ Loading 蒙层 ═══ */
.loading-overlay {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(8rpx);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}
.loading-spinner-wrap {
  display: flex; flex-direction: column; align-items: center; gap: 24rpx;
}
.loading-spinner {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  border: 6rpx solid #e8ecf2;
  border-top-color: #2b63f6;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  font-size: 28rpx; color: #5c6b82; font-weight: 500;
}
