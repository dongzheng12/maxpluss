.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #ffe9cb 0%, #ffd3a5 100%);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #5a3a0f;
  margin-bottom: 12rpx;
}

.hero-body {
  font-size: 26rpx;
  color: #7a5520;
  line-height: 1.6;
}

.state-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 28rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: #999;
}

.state-text.error {
  color: #e64c4c;
}

.retry-btn {
  margin-top: 24rpx;
}

.qr-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.qr-img {
  width: 480rpx;
  height: 480rpx;
  border-radius: 12rpx;
}

.qr-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.code-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.code-label {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.code-value {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #222;
  font-family: 'PingFang SC', -apple-system, monospace;
}

.copy-btn {
  flex-shrink: 0;
}

.stats-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stats-label {
  font-size: 28rpx;
  color: #666;
}

.stats-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #1677ff;
}

.rules {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 48rpx;
}

.rules-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.rules-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
