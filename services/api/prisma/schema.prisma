  archiveTags          Json?
  recommendedTaskType  String?
  executionDescription String?
  submitRequirement    String?
  requiredMaterials    Json?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  template SEIndustryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model StandardExecutionTask {
  id                String    @id @default(cuid())
  enterpriseId      String
  requirementId     String?
  planId            String?   // nullable FK → StandardExecutionPlan; null = 未关联计划
  title             String
  description       String?
  taskType          String?   // TRAINING | QUALIFICATION_MATERIAL | ONBOARDING_ACCESS | INSPECTION_FILL | RECTIFICATION | ARCHIVE_MATERIAL | legacy templates
  // 任务类型结构化配置：
  // - INSPECTION_FILL → checklistSchema: { items: [{ id, name, judgeType: 'TEXT'|'BOOL'|'NUMBER_RANGE', min?, max?, unit? }] }
  // - PARAMETER       → parametersSchema: { items: [{ id, name, standard, unit, method? }] }
  // - TRAINING        → learningMaterials: { items: [{ type: 'file'|'link', url, name }] }
  //                   → quizBankId (可选) 关联题库
  checklistSchema   Json?
  parametersSchema  Json?
  learningMaterials Json?
  basisSnapshots    Json?     // B-lite: 任务创建时锁定执行依据/来源快照；展示优先读快照，老数据 fallback FK
  quizBankId        String?   // 关联题库（仅 TRAINING 类型使用）
  submitRequirement String?
  deadlineAt        DateTime? @db.Timestamptz(3)
  deadlineMode      String    @default("FIXED") // FIXED | AFTER_APPROVAL_DAYS
  deadlineDaysAfterApproval Int?
  reviewerId        String?
  status            String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | PUBLISHED | IN_PROGRESS | COMPLETED | OVERDUE | CANCELLED
  submittedForApprovalAt DateTime? @db.Timestamptz(3)
  approvedAt        DateTime? @db.Timestamptz(3)
  publishedAt       DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  cancelledAt       DateTime? @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3) // 软删除：非 null = 已删（仅 DRAFT 可删）；所有列表/详情查询过滤 deletedAt:null
  createdBy         String
  updatedBy         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt        @db.Timestamptz(3)

  requirement StandardExecutionRequirement?  @relation(fields: [requirementId], references: [id])
  plan        StandardExecutionPlan?         @relation(fields: [planId], references: [id])
  quizBank    SEQuestionBank?                @relation(fields: [quizBankId], references: [id])
  assignees   StandardExecutionTaskAssignee[]
  submissions StandardExecutionSubmission[]
  reviewLogs  StandardExecutionReviewLog[]
  approvalLogs StandardExecutionTaskApprovalLog[]
  records     StandardExecutionRecord[]
  items       StandardExecutionTaskItem[]
  quizResults SEQuizResult[]

  @@index([enterpriseId])
  @@index([enterpriseId, requirementId])
  @@index([enterpriseId, planId])
  @@index([enterpriseId, status])
  @@index([enterpriseId, deadlineAt])
  @@index([enterpriseId, reviewerId])
  @@index([enterpriseId, quizBankId])
  @@index([enterpriseId, submittedForApprovalAt])
}

model StandardExecutionTaskAssignee {
  id           String    @id @default(cuid())
  enterpriseId String
  taskId       String
  assigneeId   String
  departmentId String?
  reviewerId   String?
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | PENDING_REVIEW | REJECTED | COMPLETED | OVERDUE
  submittedAt  DateTime? @db.Timestamptz(3)
  reviewedAt   DateTime? @db.Timestamptz(3)
