  status       String   @default("CREATED") // CREATED | SKIPPED | FAILED
  createdTaskIds Json?
  errorMessage String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  plan StandardExecutionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, runDate])
  @@index([enterpriseId])
  @@index([enterpriseId, planId])
  @@index([enterpriseId, runDate])
}

model StandardExecutionTaskItem {
  id            String    @id @default(cuid())
  taskId        String
  requirementId String
  status        String    @default("PENDING") // PENDING | DONE | SKIPPED
  note          String?
  fileUrls      Json?     // string[] JSON；空时 null，业务层 ?? []
  completedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt        @db.Timestamptz(3)

  task        StandardExecutionTask        @relation(fields: [taskId], references: [id])
  requirement StandardExecutionRequirement @relation(fields: [requirementId], references: [id])
  records     StandardExecutionRecord[]
  progresses  StandardExecutionTaskItemProgress[]

  @@index([taskId])
  @@index([requirementId])
}

model StandardExecutionTaskItemProgress {
  id            String    @id @default(cuid())
  enterpriseId  String
  taskId        String
  taskItemId    String
  requirementId String
  assigneeId    String
  status        String    @default("PENDING") // PENDING | DONE | SKIPPED
  note          String?
  fileUrls      Json?
  completedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt        @db.Timestamptz(3)

  taskItem StandardExecutionTaskItem @relation(fields: [taskItemId], references: [id])

  @@unique([taskItemId, assigneeId])
  @@index([enterpriseId])
  @@index([enterpriseId, taskId])
  @@index([enterpriseId, assigneeId])
  @@index([enterpriseId, taskItemId])
}
