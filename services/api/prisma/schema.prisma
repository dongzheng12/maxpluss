  industryCategory  String // MANUFACTURING | FOOD_SAFETY | MEDICAL_DEVICE | SECURITY | GENERAL | OTHER
  title             String
  sourceNo          String?
  version           String?
  description       String?
  status            String   @default("DRAFT") // DRAFT | PUBLISHED | OFFLINE
  controlPointCount Int      @default(0)
  createdBy         String
  updatedBy         String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  items SEIndustryTemplateItem[]

  @@index([industryCategory])
  @@index([status])
  @@index([industryCategory, status])
}

model SEIndustryTemplateItem {
  id                   String   @id @default(cuid())
  templateId           String
  clauseNo             String?
  title                String
  requirementText      String
