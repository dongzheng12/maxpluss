// ────────────────────────────────────────────────────────────
// standard-execution 业务表（实际 18 张含 Plan/TaskItem/QuizBank/QuizResult/Risk；详见 必读/02_技术架构.md §四 SE 模块核心模型）
// 一期单租户：enterpriseId 默认 'DEFAULT'，所有查询必须按 enterpriseId 隔离
// ────────────────────────────────────────────────────────────

model StandardExecutionSource {
  id           String   @id @default(cuid())
  enterpriseId String
  title        String
  sourceType   String   // PRODUCT_STANDARD | TECH_STANDARD | INTERNAL_POLICY | CHECKLIST | CUSTOM
  sourceNo     String?
  version      String?
  rawText      String?
  fileUrl      String?
  ownershipTier String?  @default("R") // R=Restricted public standard; O=Owned/authorized enterprise document
  parentSourceId String?
  isLatestVersion Boolean @default(true)
  versionChangeSummary Json?
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  createdBy    String
  updatedBy    String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt        @db.Timestamptz(3)

  requirements StandardExecutionRequirement[]
  plans        StandardExecutionPlan[]
  declarations StandardExecutionSourceDeclaration[]

  @@index([enterpriseId])
  @@index([enterpriseId, sourceType])
  @@index([enterpriseId, status])
  @@index([enterpriseId, ownershipTier])
  @@index([enterpriseId, parentSourceId])
  @@index([enterpriseId, isLatestVersion])
}

model StandardExecutionSourceDeclaration {
  id              String   @id @default(cuid())
  enterpriseId    String
  sourceId        String
  ownershipTier   String   @default("O")
  declarationText String
  declaredBy      String
  declaredAt      DateTime @default(now()) @db.Timestamptz(3)
  ipAddress       String?
  userAgent       String?

  source StandardExecutionSource @relation(fields: [sourceId], references: [id])

  @@index([enterpriseId])
  @@index([enterpriseId, sourceId])
  @@index([enterpriseId, declaredBy])
}

model StandardExecutionRequirement {
  id                  String   @id @default(cuid())
  enterpriseId        String
  sourceId            String
  clauseNo            String?
  title               String
  requirementText     String
  applicableDeptIds   Json?
  archiveTags         Json?
  generateMode        String   @default("MANUAL") // MANUAL | RULE | AI_STUB
  status              String   @default("REVIEW_PENDING") // DRAFT | REVIEW_PENDING | ACTIVE | DISABLED | ARCHIVED
  // P0-5: AI 解析生成的可执行字段（解析时落库；批量生成任务时 recommendedTaskType 被继承）
  recommendedTaskType  String?  // 推荐任务类型 TRAINING|QUALIFICATION_MATERIAL|...
  executionDescription String?  // 可落地执行描述
  submitRequirement    String?  // 执行人需提交什么才算完成
  requiredMaterials    Json?    // 需提交材料清单（string[]）
  parseMode            String?  // OCR_AI | RULE | AI_STUB，记录本条要求项来自哪种解析路径
  degradedReason       String?  // AI_NOT_CONFIGURED | AI_FAILED | AI_INVALID_JSON | RAWTEXT_EMPTY
  industryTemplateId     String? // C1: 从行业模板导入时记录模板来源
  industryTemplateItemId String? // C1: 从行业模板导入时记录条目来源
  requiresReview      Boolean  @default(false) // C3: 来源版本更新影响后需人工复核
  createdBy           String
  updatedBy           String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt        @db.Timestamptz(3)

  source     StandardExecutionSource     @relation(fields: [sourceId], references: [id])
  tasks      StandardExecutionTask[]
  taskItems  StandardExecutionTaskItem[]

  @@index([enterpriseId])
  @@index([enterpriseId, sourceId])
  @@index([enterpriseId, status])
  @@index([enterpriseId, industryTemplateId])
  @@index([enterpriseId, requiresReview])
}

model SEIndustryTemplate {
