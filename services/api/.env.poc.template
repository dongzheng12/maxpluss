# POC 环境变量模板 — cp .env.poc.template .env.poc 后填入真实值
#
# 范围:POC dry run 最小集(不接真实微信支付回调,WX 接 mock 或填真值)
# 与现有代码 process.env.* 读取点对齐(见 services/api/src 各 .ts 文件)
#
# 提交策略:本 template 不含真实 secret,提交进 git;.env.poc 在 .gitignore 里禁止提交。

# ── 数据库(PG)──────────────────────────────────────
DATABASE_URL=postgresql://bxz_poc:<password>@127.0.0.1:5433/bxz_poc

# ── 服务基础 ──────────────────────────────────────────────
PORT=3010
NODE_ENV=production
BXZ_ENV=poc                    # 业务分支用(docker-compose / 部署脚本读)
TZ=Asia/Shanghai

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=<填入,>=32 字节强随机,与生产物理隔离>

# ── 内部能力服务 HMAC ─────────────────────────────────────
BXZ_INTERNAL_SECRET=<填入>      # dedup 通信密钥,缺失拒启动
DEDUP_SERVICE_URL=http://127.0.0.1:8067

# ── 上传 ───────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads-poc     # POC 隔离路径,不写生产 uploads

# ── 微信小程序(P1-001:缺这两个 wx-login 就 502)──────────
WX_APPID=<小程序 AppID>
WX_SECRET=<小程序 AppSecret>    # 注:src 读 WX_SECRET(不是 WX_APP_SECRET)

# ── 微信支付 V3(dry run 用 mock,不接真实支付回调)────────
WECHAT_PAY_MCH_ID=mock
WECHAT_PAY_APPID=mock
WECHAT_PAY_SERIAL_NO=mock
WECHAT_PAY_API_V3_KEY=mock
WECHAT_PAY_PRIVATE_KEY=/dev/null
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PUB_KEY_ID=
WECHAT_PAY_PUB_KEY=

# ── 本地/POC mock 支付开关 ──────────────────────────────
# BXZ_PAY_AUTO_SUCCESS=true：mock 模式下直接标 PAID，跳过"上传凭证 + admin 确认"流程
# 生产环境不需要此项（真实支付走微信回调，loadConfig() 非 null 根本进不到 mock 分支）
BXZ_PAY_AUTO_SUCCESS=true

# ── 优惠券开关(env 优先级最高)─────────────────────────
BXZ_COUPON_ENABLED=false

# ── 企业申请钉钉通知（业务群，与 ALERT_WEBHOOK_URL 区分） ──
# 可指向测试群或留空（留空时接口照常工作，不推送）
ENTERPRISE_APPLY_WEBHOOK_URL=
ENTERPRISE_APPLY_SIGN_SECRET=

# ── LLM（呼叫小智 / AI 规则解析）──────────────────────
SVC_LLM_PRIMARY_KEY=<DeepSeek API Key>
SVC_LLM_FALLBACK_KEY=<通义千问 API Key，可留空>

# ── SE 向量索引 / Embedding / Qdrant ─────────────────
QDRANT_URL=http://127.0.0.1:6333
VECTOR_INDEX_ENABLED=1
VECTOR_INDEX_INTERVAL_MS=300000
EMBED_API_URL=https://api.openai.com/v1/embeddings
EMBED_API_KEY=<由用户在服务器 secrets 设置>
EMBED_MODEL=text-embedding-3-small
EMBED_VECTOR_SIZE=1536
