# ─────────────────────────────────────────────────────────────
# Smoke 测试环境变量模板（不含敏感值）
#
# 复制为 .env.smoke.local / .env.smoke.preprod / .env.smoke.prod 后填值。
# 这些 .env.smoke.{local,preprod,prod} 文件 **不进 git**（已在 .gitignore）。
# ─────────────────────────────────────────────────────────────

# 必须与命令行 --env 一致；runner 会校验
SMOKE_ENV=local

# 目标 API 根地址
# local   = http://localhost:3000
# preprod = http://154.8.197.13:8083
# prod    = https://api.biaozhunxiaozhi.com
SMOKE_BASE_URL=http://localhost:3000

# 是否允许写入测试
# local/preprod 可填 true；prod 必须 false（runner 启动会硬阻）
SMOKE_ALLOW_WRITES=true

# 测试账号（密码不要提交）
SMOKE_ADMIN_PHONE=18500228507
SMOKE_ADMIN_PASSWORD=
SMOKE_SALES_PHONE=13581916569
SMOKE_SALES_PASSWORD=
# user 账号 prod 可缺；local/preprod 跑 RBAC 必填
SMOKE_USER_PHONE=13800000001
SMOKE_USER_PASSWORD=

# 写入数据前缀（cleanup 按此前缀清理；保持短，因 AdminRole.name 限 40 字符）
SMOKE_CLEANUP_PREFIX=SMK_

# 单接口超时
SMOKE_TIMEOUT_MS=15000

# 详细日志
SMOKE_VERBOSE=false
