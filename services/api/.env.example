# ══════════════════════════════════════════════════════════
# 标准小智 API 环境变量模板
# 复制为 .env 后填入实际值；标 [必填] 的缺失会导致启动失败或功能不可用
# ══════════════════════════════════════════════════════════

# ── 数据库 ─────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@localhost:5432/biaozhunxiaozhi" # [必填] PostgreSQL dev 库连接串

# ── 服务基础 ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development                           # production 时关闭 demo 后门和 Swagger
CORS_ORIGINS=                                  # 逗号分隔的域名白名单，留空则按 NODE_ENV 默认
UPLOAD_DIR=./uploads                           # 上传文件存储目录

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=dev-only-replace-in-production      # [必填] 生产环境必须强随机 >= 32 字节

# ── 内部能力服务 HMAC ─────────────────────────────────────
BXZ_INTERNAL_SECRET=                           # [必填] dedup 通信密钥，缺失拒启动
DEDUP_SERVICE_URL=http://127.0.0.1:8067        # dedup 服务地址

# ── 微信小程序 ─────────────────────────────────────────────
WX_APPID=                                      # 小程序 AppID
WX_SECRET=                                     # 小程序 Secret

# ── 微信公众号（服务号）JS-SDK ────────────────────────────
# 与小程序凭证完全独立，互用会报 errcode 40013
# 用于 H5 落地页 wx.config 签名（/api/wechat/jsapi-signature）
WX_MP_APPID=                                   # 公众号 AppID
WX_MP_APPSECRET=                               # 公众号 AppSecret

# ── 微信支付 V3 ───────────────────────────────────────────
WECHAT_PAY_MCH_ID=                             # 商户号
WECHAT_PAY_APPID=                              # 支付关联 AppID（可能与小程序不同）
WECHAT_PAY_SERIAL_NO=                          # 证书序列号
WECHAT_PAY_PRIVATE_KEY=./certs/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=                         # V3 API 密钥
WECHAT_PAY_NOTIFY_URL=https://api.biaozhunxiaozhi.com/api/pay/notify
WECHAT_PAY_PUB_KEY_ID=                         # 公钥 ID（公钥模式验签）
WECHAT_PAY_PUB_KEY=                            # 公钥 PEM 内容或文件路径

# ── 邮件发送（SMTP）──────────────────────────────────────
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=标准小智 <noreply@example.com>

# ── 阿里云短信 ─────────────────────────────────────────────
ALI_SMS_ACCESS_KEY_ID=
ALI_SMS_ACCESS_KEY_SECRET=
ALI_SMS_SIGN_NAME=通标中研
ALI_SMS_TEMPLATE_CODE=SMS_505025095

# ── LLM Primary（DeepSeek）─────────────────────────────────
SVC_LLM_PRIMARY_KEY=                           # DeepSeek API Key

# ── LLM Fallback（通义千问 DashScope）──────────────────────
# 同时承担：
#   1. LLM stream/non-stream fallback（OpenAI compatible-mode）
#   2. Embedding（text-embedding-v3）
#   3. 呼叫小智本地 empty 时的联网搜索（DashScope 原生 + enable_search）
# 缺失则联网降级关闭，对话仍能跑（走 DeepSeek primary + 本地引导词兜底）
SVC_LLM_FALLBACK_KEY=                          # 通义千问 API Key

# ── SE 向量索引 / Embedding / Qdrant ─────────────────────
QDRANT_URL=http://127.0.0.1:6333
VECTOR_INDEX_ENABLED=1                         # 0=关闭启动扫描；默认开启，失败只记日志
VECTOR_INDEX_INTERVAL_MS=300000
EMBED_API_URL=https://api.openai.com/v1/embeddings
EMBED_API_KEY=                                 # 真实 Key 存 secrets，不写入模板
EMBED_MODEL=text-embedding-3-small
EMBED_VECTOR_SIZE=1536
EMBED_MOCK=0                                   # 仅本地可设 1；production 强制不使用 mock
SEARCH_API_PROVIDER=tavily                    # tavily | serper；解析 V2 互联网检索
SEARCH_API_KEY=                               # 真实 Key 存 secrets，不写入模板
SEARCH_ENABLED=false                          # 本地默认关闭；开启时失败也会降级跳过
SEARCH_TIMEOUT_MS=10000

# ── Python 搜索服务 ────────────────────────────────────────
PYAPI_BASE_URL=http://localhost:8082           # 生产经 nginx 转发

# ── 告警 Webhook ───────────────────────────────────────────
ALERT_WEBHOOK_URL=                             # 企微/钉钉群机器人 webhook（可选）

# ── 企业申请钉钉通知（业务群，与 ALERT_WEBHOOK_URL 区分） ──
# 留空则跳过推送，接口功能不受影响
ENTERPRISE_APPLY_WEBHOOK_URL=
ENTERPRISE_APPLY_SIGN_SECRET=

# ── 上传文件保留策略 ───────────────────────────────────────
UPLOAD_RETAIN_DAYS=7                           # 上传文件默认保留 7 天，超期自动清理

# ── 异步任务模式 ───────────────────────────────────────────
BXZ_TASK_ASYNC_MODE=0                          # 1=启用异步状态机（2 slot 并发）

# ── 本地/POC mock 开关（生产不设或设 false）─────────────────
# mock 支付自动成功（跳过"扫码 + 上传凭证 + admin 确认"流程），仅本地/POC 用
BXZ_PAY_AUTO_SUCCESS=true
# 微信 wx.login() code2Session 走 mock（跳过真实微信调用），仅本地/POC 用
BXZ_DEV_MOCK_WX_LOGIN=true

# ── 营销自动化 ─────────────────────────────────────────────
# [必填] n8n → /api/internal/* 调用密钥；生产用 `openssl rand -hex 32` 生成
INTERNAL_API_SECRET=

# ── n8n（docker-compose.n8n.yml 读取）───────────────────────
# [必填] n8n 控制台登录密码（建议强随机，避免 basic auth 暴力破解）
N8N_PASSWORD=
N8N_USER=admin
# [必填] n8n 工作流回调 bxz-api 的地址；容器内用 host.docker.internal 或实际内网 IP
# 示例：http://host.docker.internal:3000  或  http://10.x.x.x:3000
BXZ_API_URL=
