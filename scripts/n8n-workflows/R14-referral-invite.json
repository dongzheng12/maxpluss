{
  "name": "R14 - 裂变邀请",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "trigger-r14",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.BXZ_API_URL}}/api/internal/users/rule/R14",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{$env.INTERNAL_API_SECRET}}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "fetch-users-r14",
      "name": "Fetch users R14",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-users",
              "leftValue": "={{$json.users.length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "has-users-r14",
      "name": "Has users?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "users",
        "options": {}
      },
      "id": "split-users-r14",
      "name": "Split users",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        920,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BXZ_API_URL}}/api/internal/push/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-token",
              "value": "={{$env.INTERNAL_API_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"userId\": \"{{$json.userId}}\",\n  \"openid\": \"{{$json.openid}}\",\n  \"ruleId\": \"R14\",\n  \"templateId\": \"{{$json.templateId}}\",\n  \"templateData\": {{JSON.stringify($json.templateData)}},\n  \"refId\": {{$json.refId ? '\"' + $json.refId + '\"' : 'null'}}\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "push-send-r14",
      "name": "Push send R14",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        220
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Fetch users R14",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch users R14": {
      "main": [
        [
          {
            "node": "Has users?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has users?": {
      "main": [
        [
          {
            "node": "Split users",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Split users": {
      "main": [
        [
          {
            "node": "Push send R14",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "marketing"
    },
    {
      "name": "R14"
    }
  ]
}
